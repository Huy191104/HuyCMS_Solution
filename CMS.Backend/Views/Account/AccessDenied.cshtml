@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Không có quyền truy cập";
}

<style>
    .ad-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
        padding: 48px 24px;
    }

    .ad-icon {
        width: 72px;
        height: 72px;
        border-radius: 18px;
        background: #FEF2F2;
        border: 1px solid #FECACA;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: #DC3545;
        margin: 0 auto 24px;
    }

    .ad-code {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #DC3545;
        margin-bottom: 10px;
    }

    .ad-title {
        font-size: 22px;
        font-weight: 600;
        color: #212529;
        margin-bottom: 8px;
    }

    .ad-desc {
        font-size: 13px;
        color: #6C757D;
        line-height: 1.7;
        margin-bottom: 28px;
        max-width: 380px;
    }

    .ad-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .ad-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: 9px 20px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s;
    }

        .ad-btn-primary:hover {
            background: #1D4ED8;
            color: #fff;
        }

    .ad-btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        color: #495057;
        border: 1px solid #E9ECEF;
        border-radius: 7px;
        padding: 9px 20px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s;
    }

        .ad-btn-outline:hover {
            background: #E9ECEF;
            color: #212529;
        }
</style>

<div class="ad-wrap">
    <div class="ad-icon">
        <i class="bi bi-shield-lock"></i>
    </div>
    <div class="ad-code">Lỗi 403</div>
    <div class="ad-title">Không có quyền truy cập</div>
    <p class="ad-desc">
        Bạn không có đủ quyền hạn để xem trang này.
        Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là nhầm lẫn.
    </p>
    <div class="ad-actions">
        <a asp-controller="Home" asp-action="Index" class="ad-btn-primary">
            <i class="bi bi-speedometer2"></i> Về Dashboard
        </a>
        <a asp-controller="Account" asp-action="Logout" class="ad-btn-outline">
            <i class="bi bi-box-arrow-right"></i> Đăng xuất
        </a>
    </div>
</div>
