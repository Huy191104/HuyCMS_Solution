@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<style>
    .pg-header {
        margin-bottom: 20px;
    }

    .pg-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin-bottom: 2px;
    }

    .pg-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

    .cf-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 10px;
        overflow: hidden;
    }

    .cf-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid #E9ECEF;
        background: #F8F9FA;
    }

    .cf-card-title {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        color: #212529;
    }

    .cf-card-body {
        padding: 20px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 180px 1fr;
        row-gap: 14px;
        column-gap: 20px;
    }

    .info-label {
        font-size: 13px;
        font-weight: 600;
        color: #495057;
    }

    .info-value {
        font-size: 13px;
        color: #212529;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-pending {
        background: #FEF3C7;
        color: #92400E;
        border: 1px solid #FCD34D;
    }

    .status-shipping {
        background: #DBEAFE;
        color: #1D4ED8;
        border: 1px solid #93C5FD;
    }

    .status-completed {
        background: #DCFCE7;
        color: #15803D;
        border: 1px solid #86EFAC;
    }

    .status-cancelled {
        background: #FEE2E2;
        color: #B91C1C;
        border: 1px solid #FCA5A5;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        color: #495057 !important;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 8px 14px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: .15s;
    }

        .btn-back:hover {
            background: #E9ECEF;
        }

    .footer-actions {
        margin-top: 20px;
    }
</style>

<div class="pg-header">
    <h2 class="pg-title">
        Chi tiết đơn hàng #@Model.Id
    </h2>

    <div class="pg-subtitle">
        Xem thông tin chi tiết đơn hàng trong hệ thống
    </div>
</div>

<div class="cf-card">

    <div class="cf-card-header">
        <h5 class="cf-card-title">
            Thông tin đơn hàng
        </h5>
    </div>

    <div class="cf-card-body">

        <div class="info-grid">

            <div class="info-label">
                Mã đơn hàng
            </div>
            <div class="info-value">
                #@Model.Id
            </div>

            <div class="info-label">
                Khách hàng
            </div>
            <div class="info-value">
                @(Model.Customer?.FullName ?? "Không xác định")
            </div>

            <div class="info-label">
                Ngày đặt hàng
            </div>
            <div class="info-value">
                @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
            </div>

            <div class="info-label">
                Trạng thái
            </div>
            <div class="info-value">

                @if (Model.Status == 0)
                {
                    <span class="status-badge status-pending">
                        Chờ duyệt
                    </span>
                }
                else if (Model.Status == 1)
                {
                    <span class="status-badge status-shipping">
                        Đang giao
                    </span>
                }
                else if (Model.Status == 2)
                {
                    <span class="status-badge status-completed">
                        Hoàn thành
                    </span>
                }
                else
                {
                    <span class="status-badge status-cancelled">
                        Đã hủy
                    </span>
                }

            </div>

            <div class="info-label">
                Số sản phẩm
            </div>
            <div class="info-value">
                @(Model.OrderDetails?.Count ?? 0)
            </div>

            <div class="info-label">
                Ghi chú
            </div>
            <div class="info-value">
                @(string.IsNullOrWhiteSpace(Model.Notes)
                    ? "Không có ghi chú"
                    : Model.Notes)
            </div>

        </div>

        <!-- Order Items Section -->
        <h5 class="cf-card-title" style="margin-top: 30px; margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid #E9ECEF;">
            Danh sách sản phẩm đã mua
        </h5>
        <div class="table-responsive" style="border: 1px solid #E9ECEF; border-radius: 8px; overflow: hidden; margin-bottom: 20px;">
            <table class="table table-hover align-middle" style="margin-bottom: 0; font-size: 13px;">
                <thead class="table-light">
                    <tr>
                        <th style="padding: 10px 14px; font-weight: 600; color: #6C757D;">Hình ảnh</th>
                        <th style="padding: 10px 14px; font-weight: 600; color: #6C757D;">Tên sản phẩm</th>
                        <th style="padding: 10px 14px; font-weight: 600; color: #6C757D; width: 100px; text-align: center;">Số lượng</th>
                        <th style="padding: 10px 14px; font-weight: 600; color: #6C757D; width: 150px; text-align: right;">Đơn giá</th>
                        <th style="padding: 10px 14px; font-weight: 600; color: #6C757D; width: 180px; text-align: right; padding-right: 14px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails == null || !Model.OrderDetails.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Không có sản phẩm nào trong đơn hàng này.
                            </td>
                        </tr>
                    }
                    else
                    {
                        decimal totalSum = 0;
                        foreach (var detail in Model.OrderDetails)
                        {
                            var itemTotal = detail.Quantity * detail.UnitPrice;
                            totalSum += itemTotal;
                            <tr>
                                <td style="padding: 10px 14px;">
                                    @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ImageUrl))
                                    {
                                        <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #E9ECEF;" />
                                    }
                                    else
                                    {
                                        <div style="width: 50px; height: 50px; background: #F1F3F5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #ADB5BD; font-size: 18px;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td style="padding: 10px 14px;">
                                    <div style="font-weight: 600; color: #212529;">@(detail.Product?.Name ?? "Sản phẩm không tồn tại")</div>
                                    <div class="text-muted" style="font-size: 11px;">Mã sản phẩm: #@detail.ProductId</div>
                                </td>
                                <td class="text-center" style="padding: 10px 14px;">@detail.Quantity</td>
                                <td class="text-right" style="text-align: right; padding: 10px 14px;">@detail.UnitPrice.ToString("N0") ₫</td>
                                <td class="text-right" style="text-align: right; padding: 10px 14px; padding-right: 14px; font-weight: 600; color: #16A34A;">@itemTotal.ToString("N0") ₫</td>
                            </tr>
                        }
                        <tr class="table-light" style="font-weight: 600;">
                            <td colspan="4" class="text-right" style="text-align: right; padding: 12px 14px;">Tổng giá trị đơn hàng:</td>
                            <td class="text-right" style="text-align: right; padding: 12px 14px; padding-right: 14px; font-size: 14px; color: #DC3545; font-weight: 700;">@totalSum.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="footer-actions" style="display: flex; gap: 8px;">
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i>
                Quay lại danh sách đơn hàng
            </a>
            <a asp-controller="OrderDetails" asp-action="Index" class="btn-back">
                <i class="bi bi-list-ul"></i>
                Danh sách chi tiết sản phẩm
            </a>
        </div>

    </div>

</div>