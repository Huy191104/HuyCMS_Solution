@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Đơn hàng";
}
<style>
    .pg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .pg-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
    }

    .pg-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

        .pg-subtitle strong {
            color: #212529;
        }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 6px 10px;
        max-width: 280px;
        flex: 1;
    }

        .search-box i {
            font-size: 13px;
            color: #ADB5BD;
        }

        .search-box input {
            border: none;
            background: transparent;
            font-size: 13px;
            color: #212529;
            outline: none;
            width: 100%;
        }

    .count-badge {
        font-size: 11px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
        white-space: nowrap;
    }

    .tbl-wrap {
        border: 1px solid #E9ECEF;
        border-radius: 8px;
        overflow: hidden;
    }

    .tbl {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .tbl thead tr {
            background: #F8F9FA;
        }

        .tbl th {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #6C757D;
            text-align: left;
            border-bottom: 1px solid #E9ECEF;
        }

        .tbl td {
            padding: 11px 14px;
            color: #212529;
            border-bottom: 1px solid #F1F3F5;
            vertical-align: middle;
        }

        .tbl tbody tr:last-child td {
            border-bottom: none;
        }

        .tbl tbody tr:hover {
            background: #F8F9FA;
        }

    .id-badge {
        display: inline-block;
        background: #F1F3F5;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 1px 7px;
        font-size: 11px;
        font-weight: 500;
        color: #495057;
    }

    .cat-badge {
        display: inline-block;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 500;
    }

    .cat-none {
        display: inline-block;
        background: #F1F3F5;
        color: #6C757D;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
    }

    .date-text {
        font-size: 12px;
        color: #6C757D;
        white-space: nowrap;
    }

    .actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-detail {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #F0FDF4;
        color: #15803D !important;
        border: 1px solid #BBF7D0;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: .12s;
    }

        .btn-detail:hover {
            background: #DCFCE7;
            color: #15803D !important;
        }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #EFF6FF;
        color: #1D4ED8 !important;
        border: 1px solid #BFDBFE;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: .12s;
    }

        .btn-edit:hover {
            background: #DBEAFE;
            color: #1D4ED8 !important;
        }

    .btn-del {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #FEF2F2;
        color: #991B1B !important;
        border: 1px solid #FECACA;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: .12s;
    }

        .btn-del:hover {
            background: #FEE2E2;
            color: #991B1B !important;
        }

    .tbl-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 12px;
    }

    .footer-info {
        font-size: 12px;
        color: #6C757D;
    }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .pagination {
        display: flex;
        gap: 6px;
    }

    .page-btn {
        min-width: 38px;
        height: 38px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 500;
    }

        .page-btn:hover {
            background: #F3F4F6;
        }

        .page-btn.active {
            background: #2563EB;
            color: white;
            border-color: #2563EB;
        }

    .btn-export-excel {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #16A34A;
        color: #fff !important;
        border: none;
        border-radius: 6px;
        padding: 7px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-export-excel:hover {
            background: #15803D;
            color: #fff !important;
        }
</style>

<div class="pg-header">
    <div>
        <h2 class="pg-title">Danh sách đơn hàng</h2>
        <div class="pg-subtitle">
            Tổng số: <strong>@ViewBag.TotalItems đơn hàng</strong>
        </div>
    </div>

    <a asp-action="ExportToExcel"
       asp-route-search="@ViewBag.Search"
       asp-route-status="@ViewBag.Status"
       class="btn-export-excel">
        <i class="bi bi-file-earmark-excel"></i> Xuất Excel
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="border-radius: 8px; font-size: 13px; margin-bottom: 15px; padding: 10px 14px;">
        <i class="bi bi-exclamation-triangle-fill" style="margin-right: 6px;"></i> @TempData["Error"]
    </div>
}

@{
    int? currentStatus = ViewBag.Status as int?;
}
<form method="get" action="@Url.Action("Index")" class="toolbar" id="filterForm">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Tìm theo khách hàng..." />
    </div>

    <div style="display: flex; gap: 8px; align-items: center;">
        <select name="status" class="form-select form-select-sm" style="font-size: 13px; border-radius: 6px; padding: 6px 12px; border: 1px solid #E9ECEF; min-width: 220px;" onchange="this.form.submit()">
            <option value="" selected="@(currentStatus == null)">Tất cả trạng thái</option>
            <option value="0" selected="@(currentStatus == 0)">Chờ duyệt</option>
            <option value="1" selected="@(currentStatus == 1)">Đang giao</option>
            <option value="2" selected="@(currentStatus == 2)">Hoàn thành</option>
        </select>
        <button type="submit" class="btn btn-primary btn-sm" style="background: #2563EB; color: #fff; border: none; border-radius: 6px; padding: 6px 14px; font-size: 13px; font-weight: 500; cursor: pointer;">Lọc</button>
    </div>

    <span class="count-badge" id="countBadge" style="margin-left: auto;">
        @ViewBag.TotalItems kết quả
    </span>
</form>

<div class="tbl-wrap">
    <table class="tbl" id="orderTable">

        <thead>
            <tr>
                <th style="width:90px">ID</th>
                <th>Khách hàng</th>
                <th style="width:130px">Ngày đặt</th>
                <th style="width:130px">Trạng thái</th>
                <th>Ghi chú</th>
                <th style="width:260px;text-align:center">Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        <span class="id-badge">#@item.Id</span>
                    </td>

                    <td class="customer-name">
                        @(item.Customer?.FullName ?? "Không xác định")
                    </td>

                    <td>
                        <span class="date-text">
                            @item.OrderDate.ToString("dd/MM/yyyy")
                        </span>
                    </td>

                    <td>

                        @if (item.Status == 0)
                        {
                            <span class="cat-none">Chờ duyệt</span>
                        }
                        else if (item.Status == 1)
                        {
                            <span class="cat-badge">Đang giao</span>
                        }
                        else if (item.Status == 2)
                        {
                            <span class="cat-badge" style="background:#F0FDF4;color:#15803D;border-color:#BBF7D0">
                                Hoàn thành
                            </span>
                        }
                    </td>

                    <td>
                        @item.Notes
                    </td>

                    <td>
                        <div class="actions">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn-detail">
                                <i class="bi bi-eye"></i>
                                Chi tiết
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-edit">
                                <i class="bi bi-pencil-square"></i>
                                Sửa
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn-del">
                                <i class="bi bi-trash"></i>
                                Xóa
                            </a>

                        </div>
                    </td>

                </tr>
            }

        </tbody>

    </table>
</div>

<div class="tbl-footer">
    <div class="footer-info" id="footerInfo">
        Hiển thị
        <strong>@Model.Count()</strong>
        trong tổng
        <strong>@ViewBag.TotalItems</strong>
        đơn hàng
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <div class="pagination-wrap">
        <div class="pagination">
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-status="@ViewBag.Status"
                   class="page-btn">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-search="@ViewBag.Search"
                   asp-route-status="@ViewBag.Status"
                   class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")">
                    @i
                </a>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-status="@ViewBag.Status"
                   class="page-btn">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}

@section Scripts {
    <!-- Đã chuyển sang tìm kiếm và lọc Server-side -->
}