@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Cập nhật đơn hàng";
}

<style>
    .pg-header {
        margin-bottom: 20px;
    }

    .pg-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin-bottom: 2px;
    }

    .pg-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

    .cf-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 10px;
        padding: 20px;
    }

    .cf-card-title {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #6C757D;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #E9ECEF;
    }

    .cf-group {
        margin-bottom: 16px;
    }

    .cf-label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 6px;
        color: #212529;
    }

    .cf-input {
        width: 100%;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        outline: none;
        transition: .15s;
    }

        .cf-input:focus {
            background: #fff;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    textarea.cf-input {
        resize: vertical;
        min-height: 120px;
    }

    .cf-actions {
        display: flex;
        gap: 8px;
        margin-top: 20px;
    }

    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563EB;
        color: #fff !important;
        border: none;
        border-radius: 6px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: .15s;
    }

        .btn-save:hover {
            background: #1D4ED8;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        color: #495057 !important;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: .15s;
    }

        .btn-cancel:hover {
            background: #E9ECEF;
        }
</style>

<div class="pg-header">
    <h2 class="pg-title">Cập nhật đơn hàng</h2>
    <div class="pg-subtitle">
        Chỉnh sửa trạng thái và ghi chú của đơn hàng #@Model.Id
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 6px; font-size: 13px; padding: 10px 14px; margin-bottom: 20px; border: 1px solid #C3E6CB; background-color: #D4EDDA; color: #155724; position: relative;">
        <i class="bi bi-check-circle-fill" style="margin-right: 6px;"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 6px; font-size: 13px; padding: 10px 14px; margin-bottom: 20px; border: 1px solid #F5C6CB; background-color: #F8D7DA; color: #721C24; position: relative;">
        <i class="bi bi-exclamation-octagon-fill" style="margin-right: 6px;"></i> @TempData["Error"]
    </div>
}

<form asp-action="Edit" method="post" id="editOrderForm">

    <input asp-for="Id" type="hidden" />

    <div class="cf-card">

        <div class="cf-card-title">
            Thông tin đơn hàng
        </div>

        <div class="cf-group">
            <label class="cf-label">
                <i class="bi bi-truck"></i>
                Trạng thái đơn hàng
            </label>

            <select asp-for="Status" class="cf-input" id="statusSelect">
                <option value="0">Chờ duyệt</option>
                <option value="1">Đang giao</option>
                <option value="2">Hoàn thành</option>
            </select>

            <div id="statusWarning" class="alert alert-warning mt-2" style="display: none; border-radius: 6px; font-size: 13px; padding: 10px 14px; border: 1px solid #FFEBA2; background-color: #FFF8E1; color: #856404; font-weight: 500;">
                <i class="bi bi-exclamation-triangle-fill" style="margin-right: 6px; color: #E0A800;"></i> Sau khi cập nhật trạng thái hoàn thành sẽ không thể thay đổi
            </div>
        </div>

        <div class="cf-group">
            <label class="cf-label">
                <i class="bi bi-chat-left-text"></i>
                Ghi chú
            </label>

            <textarea asp-for="Notes"
                      class="cf-input"
                      placeholder="Nhập ghi chú cho đơn hàng...">
            </textarea>
        </div>

        <div class="cf-actions">
            <button type="submit" class="btn-save">
                <i class="bi bi-check-circle"></i>
                Cập nhật
            </button>

            <a asp-action="Index" class="btn-cancel">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>
        </div>

    </div>

</form>

<div class="cf-card" style="margin-top: 20px;">
    <div class="cf-card-title">
        Danh sách sản phẩm đã mua
    </div>
    
    <div class="table-responsive" style="border: 1px solid #E9ECEF; border-radius: 8px; overflow: hidden;">
        <table class="table table-hover align-middle" style="margin-bottom: 0; font-size: 13px;">
            <thead class="table-light">
                <tr>
                    <th style="padding: 10px 14px; font-weight: 600; color: #6C757D;">Hình ảnh</th>
                    <th style="padding: 10px 14px; font-weight: 600; color: #6C757D;">Tên sản phẩm</th>
                    <th style="padding: 10px 14px; font-weight: 600; color: #6C757D; width: 140px; text-align: center;">Số lượng</th>
                    <th style="padding: 10px 14px; font-weight: 600; color: #6C757D; width: 150px; text-align: right;">Đơn giá</th>
                    <th style="padding: 10px 14px; font-weight: 600; color: #6C757D; width: 180px; text-align: right;">Thành tiền</th>
                    <th style="padding: 10px 14px; font-weight: 600; color: #6C757D; width: 110px; text-align: center; padding-right: 14px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrderDetails == null || !Model.OrderDetails.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Không có sản phẩm nào trong đơn hàng này.
                        </td>
                    </tr>
                }
                else
                {
                    decimal totalSum = 0;
                    foreach (var detail in Model.OrderDetails)
                    {
                        var itemTotal = detail.Quantity * detail.UnitPrice;
                        totalSum += itemTotal;
                        <tr>
                            <td style="padding: 10px 14px;">
                                @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ImageUrl))
                                {
                                    <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #E9ECEF;" />
                                }
                                else
                                {
                                    <div style="width: 50px; height: 50px; background: #F1F3F5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #ADB5BD; font-size: 18px;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </td>
                            <td style="padding: 10px 14px;">
                                <div style="font-weight: 600; color: #212529;">@(detail.Product?.Name ?? "Sản phẩm không tồn tại")</div>
                                <div class="text-muted" style="font-size: 11px;">Mã sản phẩm: #@detail.ProductId</div>
                            </td>
                            <td class="text-center" style="padding: 10px 14px;">
                                @if (Model.Status == 2)
                                {
                                    @detail.Quantity
                                }
                                else
                                {
                                    <form asp-action="UpdateItemQuantity" method="post" style="display: inline-flex; align-items: center; gap: 5px; justify-content: center;">
                                        <input type="hidden" name="orderId" value="@Model.Id" />
                                        <input type="hidden" name="detailId" value="@detail.Id" />
                                        <input type="number" name="quantity" value="@detail.Quantity" min="1" class="cf-input" style="width: 60px; padding: 4px 6px; text-align: center; margin-bottom: 0; background: #fff;" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary" style="padding: 4px 8px; border-radius: 4px;" title="Cập nhật">
                                            <i class="bi bi-save"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                            <td class="text-right" style="text-align: right; padding: 10px 14px;">@detail.UnitPrice.ToString("N0") ₫</td>
                            <td class="text-right" style="text-align: right; padding: 10px 14px; font-weight: 600; color: #16A34A;">@itemTotal.ToString("N0") ₫</td>
                            <td class="text-center" style="padding: 10px 14px; padding-right: 14px;">
                                @if (Model.Status != 2)
                                {
                                    <form asp-action="DeleteItem" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi đơn hàng?');" style="display: inline;">
                                        <input type="hidden" name="orderId" value="@Model.Id" />
                                        <input type="hidden" name="detailId" value="@detail.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="padding: 4px 8px; border-radius: 4px;" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 11px;">Không khả dụng</span>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="table-light" style="font-weight: 600;">
                        <td colspan="4" class="text-right" style="text-align: right; padding: 12px 14px;">Tổng giá trị đơn hàng:</td>
                        <td class="text-right" style="text-align: right; padding: 12px 14px; font-size: 14px; color: #DC3545; font-weight: 700;">@totalSum.ToString("N0") ₫</td>
                        <td style="padding: 12px 14px; padding-right: 14px;"></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var statusSelect = document.getElementById("statusSelect");
            var statusWarning = document.getElementById("statusWarning");
            var form = document.getElementById("editOrderForm");

            function checkStatus() {
                if (statusSelect.value === "2") {
                    statusWarning.style.display = "block";
                } else {
                    statusWarning.style.display = "none";
                }
            }

            if (statusSelect && statusWarning) {
                statusSelect.addEventListener("change", checkStatus);
                checkStatus(); // Run initial check
            }

            if (form && statusSelect) {
                form.addEventListener("submit", function(e) {
                    if (statusSelect.value === "2") {
                        var confirmed = confirm("Sau khi cập nhật trạng thái hoàn thành sẽ không thể thay đổi. Bạn có chắc chắn muốn tiếp tục?");
                        if (!confirmed) {
                            e.preventDefault();
                        }
                    }
                });
            }
        });
    </script>
}