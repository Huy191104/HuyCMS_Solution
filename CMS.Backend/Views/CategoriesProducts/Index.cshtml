@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh mục sản phẩm";
}

<style>

    .pg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .pg-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
    }

    .pg-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

        .pg-subtitle strong {
            color: #212529;
        }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563EB;
        color: #fff !important;
        border: none;
        border-radius: 6px;
        padding: 7px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
    }

        .btn-add:hover {
            background: #1D4ED8;
            color: #fff !important;
        }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 6px 10px;
        max-width: 280px;
        flex: 1;
    }

        .search-box i {
            font-size: 13px;
            color: #ADB5BD;
        }

        .search-box input {
            border: none;
            background: transparent;
            width: 100%;
            outline: none;
            font-size: 13px;
        }

    .count-badge {
        font-size: 11px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
    }

    .tbl-wrap {
        border: 1px solid #E9ECEF;
        border-radius: 8px;
        overflow: hidden;
    }

    .tbl {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .tbl thead tr {
            background: #F8F9FA;
        }

        .tbl th {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: #6C757D;
            border-bottom: 1px solid #E9ECEF;
        }

        .tbl td {
            padding: 11px 14px;
            border-bottom: 1px solid #F1F3F5;
            vertical-align: middle;
        }

        .tbl tbody tr:hover {
            background: #F8F9FA;
        }

        .tbl tbody tr:last-child td {
            border-bottom: none;
        }

    .id-badge {
        display: inline-block;
        background: #F1F3F5;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 1px 7px;
        font-size: 11px;
        font-weight: 500;
    }

    .cat-name {
        font-weight: 600;
        color: #212529;
    }

    .cat-desc {
        color: #6C757D;
        font-size: 12px;
    }

    .actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #EFF6FF;
        color: #1D4ED8 !important;
        border: 1px solid #BFDBFE;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font -weight: 500;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #DBEAFE;
        }

    .btn-del {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #FEF2F2;
        color: #991B1B !important;
        border: 1px solid #FECACA;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font -weight: 500;
        text-decoration: none;
    }

        .btn-del:hover {
            background: #FEE2E2;
        }

    .empty-state {
        text-align: center;
        padding: 50px 0;
        color: #ADB5BD;
    }

        .empty-state i {
            font-size: 32px;
            display: block;
            margin-bottom: 8px;
        }

    .tbl-footer {
        margin-top: 12px;
        font-size: 12px;
        color: #6C757D;
    }

    .cat-thumb {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #E9ECEF;
        display: block;
    }

</style>

<div class="pg-header">

    <div>
        <h2 class="pg-title">Danh mục sản phẩm</h2>
        <div class="pg-subtitle">
            Tổng số:
            <strong>@Model.Count() danh mục</strong>
        </div>
    </div>

    <a asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle"></i>
        Thêm danh mục
    </a>

</div>

<div class="toolbar">

    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               id="searchInput"
               placeholder="Tìm danh mục..." />
    </div>

    <span class="count-badge" id="countBadge">
        @Model.Count() kết quả
    </span>

</div>

<div class="tbl-wrap">

    <table class="tbl" id="categoryTable">

        <thead>
            <tr>
                <th style="width:80px">ID</th>
                <th style="width:80px; text-align:center">Ảnh</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th style="width:220px;text-align:center">Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">
                        <div class="empty-state">
                            <i class="bi bi-folder-x"></i>
                            Chưa có danh mục nào
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <span class="id-badge">
                                #@item.Id
                            </span>
                        </td>

                        <td style="text-align:center">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="cat-thumb" alt="@item.Name" style="margin: 0 auto;" />
                            }
                            else
                            {
                                <span class="text-muted" style="font-size: 11px;">Không có</span>
                            }
                        </td>

                        <td>
                            <div class="cat-name">
                                @item.Name
                            </div>
                        </td>

                        <td>
                            <div class="cat-desc">
                                @item.Description
                            </div>
                        </td>

                        <td>
                            <div class="actions">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn-edit">
                                    <i class="bi bi-pencil-square"></i>
                                    Sửa
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn-del"
                                   onclick="return confirm('Bạn có chắc muốn xóa?')">
                                    <i class="bi bi-trash"></i>
                                    Xóa
                                </a>

                            </div>
                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>

<div class="tbl-footer" id="footerInfo">
    Hiển thị <strong>@Model.Count()</strong> danh mục
</div>

@section Scripts {

    <script>

        const searchInput = document.getElementById('searchInput');
        const countBadge = document.getElementById('countBadge');

        searchInput.addEventListener('input', function () {

            const keyword = this.value.toLowerCase();

            const rows = document.querySelectorAll('#categoryTable tbody tr');

            let visible = 0;

            rows.forEach(row => {

                const name = row.querySelector('.cat-name');

                if (!name) return;

                const match = name.textContent
                    .toLowerCase()
                    .includes(keyword);

                row.style.display = match ? '' : 'none';

                if (match) visible++;

            });

            countBadge.textContent = visible + ' kết quả';

        });

    </script>

}