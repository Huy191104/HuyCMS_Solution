@model CMS.Data.Entities.CategoryProduct

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm danh mục sản phẩm";
}

<style>

    .cf-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .cf-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #2563EB;
        flex-shrink: 0;
    }

    .cf-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
    }

    .cf-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

    .cf-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 16px;
        align-items: start;
    }

    .cf-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 10px;
        padding: 20px;
    }

    .cf-card-title {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #6C757D;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #E9ECEF;
    }

    .cf-group {
        margin-bottom: 16px;
    }

    .cf-label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        font-weight: 500;
        color: #212529;
        margin-bottom: 6px;
    }

    .cf-required {
        color: #DC3545;
    }

    .cf-input {
        width: 100%;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        outline: none;
        transition: all .15s;
    }

        .cf-input:focus {
            border-color: #2563EB;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    textarea.cf-input {
        resize: vertical;
        min-height: 140px;
    }

    .cf-hint {
        font-size: 11px;
        color: #ADB5BD;
        margin-top: 4px;
    }

    .cf-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #1D4ED8;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        background: #F8F9FA;
        color: #495057;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 9px 16px;
        font-size: 13px;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #E9ECEF;
            color: #212529;
        }

    .info-box {
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        border-radius: 8px;
        padding: 12px;
        font-size: 12px;
        color: #1D4ED8;
    }

</style>

<div class="cf-header">

    <div class="cf-header-icon">
        <i class="bi bi-folder-plus"></i>
    </div>

    <div>
        <h2 class="cf-title">Thêm danh mục sản phẩm</h2>
        <div class="cf-subtitle">
            Tạo danh mục mới để phân loại sản phẩm
        </div>
    </div>

</div>

<form asp-action="Create" method="post">

    <div class="cf-layout">

        <!-- LEFT -->

        <div>

            <div class="cf-card">

                <div class="cf-card-title">
                    Thông tin danh mục
                </div>

                <div class="cf-group">

                    <label asp-for="Name" class="cf-label">
                        <i class="bi bi-folder"></i>
                        Tên danh mục
                        <span class="cf-required">*</span>
                    </label>

                    <input asp-for="Name"
                           class="cf-input"
                           placeholder="Ví dụ: Laptop Gaming" />

                </div>

                <div class="cf-group">

                    <label asp-for="Description" class="cf-label">
                        <i class="bi bi-card-text"></i>
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              class="cf-input"
                              placeholder="Nhập mô tả danh mục..."></textarea>

                </div>

            </div>

        </div>

        <!-- RIGHT -->

        <div>

            <div class="cf-card" style="margin-bottom:16px">

                <div class="cf-card-title">
                    Gợi ý
                </div>

                <div class="info-box">
                    Danh mục nên ngắn gọn, rõ ràng và dễ phân loại sản phẩm.
                </div>

            </div>

            <div class="cf-card">

                <div class="cf-card-title">
                    Hành động
                </div>

                <div class="cf-actions">

                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-circle"></i>
                        Lưu danh mục
                    </button>

                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại danh sách
                    </a>

                </div>

            </div>

        </div>

    </div>

</form>