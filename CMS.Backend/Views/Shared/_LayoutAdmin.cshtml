<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', system-ui, sans-serif;
            font-size: 14px;
            background: #F8F9FA;
            color: #212529;
        }

        /* ── Layout ── */
        .adm-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ── */
        .adm-sidebar {
            width: 220px;
            min-width: 220px;
            background: #fff;
            border-right: 1px solid #E9ECEF;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            overflow-y: auto;
            z-index: 100;
        }

        .adm-logo {
            padding: 16px;
            border-bottom: 1px solid #E9ECEF;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .adm-logo-icon {
            width: 30px;
            height: 30px;
            background: #2563EB;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 15px;
            flex-shrink: 0;
        }

        .adm-logo-name {
            font-size: 14px;
            font-weight: 600;
            color: #212529;
        }

        .adm-logo-sub {
            font-size: 10px;
            color: #6C757D;
        }

        /* Nav */
        .adm-nav {
            padding: 10px 8px;
            flex: 1;
        }

        .adm-nav-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #ADB5BD;
            padding: 0 8px;
            margin: 10px 0 4px;
            display: block;
        }

            .adm-nav-label:first-child {
                margin-top: 0;
            }

        .adm-nav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 8px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 13px;
            color: #495057;
            transition: background 0.12s, color 0.12s;
            margin-bottom: 1px;
        }

            .adm-nav-item i {
                font-size: 16px;
                width: 18px;
                text-align: center;
                flex-shrink: 0;
            }

            .adm-nav-item:hover {
                background: #F1F3F5;
                color: #212529;
            }

            .adm-nav-item.active {
                background: #EFF6FF;
                color: #1D4ED8;
                font-weight: 500;
            }

        /* Sidebar footer */
        .adm-sidebar-footer {
            padding: 12px 16px;
            border-top: 1px solid #E9ECEF;
        }

        .adm-user-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .adm-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #EFF6FF;
            color: #1D4ED8;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .adm-user-name {
            font-size: 12px;
            font-weight: 500;
            color: #212529;
        }

        .adm-user-role {
            font-size: 10px;
            color: #6C757D;
        }

        .adm-logout {
            margin-left: auto;
            color: #ADB5BD;
            text-decoration: none;
            font-size: 16px;
            display: flex;
            align-items: center;
            transition: color 0.12s;
        }

            .adm-logout:hover {
                color: #DC3545;
            }

        /* ── Main ── */
        .adm-main {
            margin-left: 220px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── Topbar ── */
        .adm-topbar {
            background: #fff;
            border-bottom: 1px solid #E9ECEF;
            padding: 11px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .adm-page-title {
            font-size: 15px;
            font-weight: 600;
            color: #212529;
            margin: 0;
        }

        .adm-breadcrumb {
            font-size: 11px;
            color: #6C757D;
            margin-top: 1px;
        }

        .adm-topbar-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── Search box ── */
        .adm-search-wrap {
            position: relative;
        }

        .adm-search-box {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #F8F9FA;
            border: 1px solid #E9ECEF;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 13px;
            color: #ADB5BD;
            cursor: text;
            transition: all .2s;
            min-width: 240px;
        }

            .adm-search-box:focus-within {
                border-color: #3B82F6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, .12);
                background: #fff;
            }

            .adm-search-box i {
                font-size: 13px;
                color: #9CA3AF;
            }

        .adm-search-input {
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
            color: #212529;
            width: 100%;
        }

            .adm-search-input::placeholder {
                color: #ADB5BD;
            }

        .adm-search-kbd {
            font-size: 10px;
            color: #9CA3AF;
            background: #E9ECEF;
            padding: 1px 6px;
            border-radius: 4px;
            font-family: monospace;
            white-space: nowrap;
        }

        /* Search dropdown */
        .adm-search-dropdown {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #E9ECEF;
            border-radius: 10px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, .12);
            z-index: 1000;
            max-height: 420px;
            overflow-y: auto;
            display: none;
        }

            .adm-search-dropdown.show {
                display: block;
                animation: searchFadeIn .2s ease;
            }

        @@keyframes searchFadeIn {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .search-group-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .8px;
            color: #9CA3AF;
            padding: 10px 16px 4px;
            font-weight: 600;
        }

        .search-result-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 16px;
            text-decoration: none;
            color: #374151;
            font-size: 13px;
            transition: background .1s;
        }

            .search-result-item:hover {
                background: #F1F5F9;
                color: #111827;
            }

        .search-result-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        .sri-order { background: #FEF3C7; color: #92400E; }
        .sri-product { background: #DBEAFE; color: #1E40AF; }
        .sri-post { background: #EDE9FE; color: #5B21B6; }
        .sri-customer { background: #D1FAE5; color: #065F46; }

        .search-result-text {
            flex: 1;
            min-width: 0;
        }

        .search-result-title {
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .search-result-sub {
            font-size: 11px;
            color: #9CA3AF;
        }

        .search-empty {
            padding: 24px 16px;
            text-align: center;
            color: #9CA3AF;
            font-size: 13px;
        }

        /* ── Notification ── */
        .adm-noti-wrap {
            position: relative;
        }

        .adm-topbar-icon {
            width: 34px;
            height: 34px;
            border: 1px solid #E9ECEF;
            border-radius: 8px;
            background: #F8F9FA;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6C757D;
            cursor: pointer;
            transition: all 0.15s;
            position: relative;
        }

            .adm-topbar-icon:hover {
                background: #E9ECEF;
                color: #374151;
            }

            .adm-topbar-icon i {
                font-size: 16px;
            }

        .noti-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: #EF4444;
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            border: 2px solid #fff;
            display: none;
        }

            .noti-badge.show {
                display: flex;
            }

        /* Notification dropdown */
        .adm-noti-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            width: 360px;
            background: #fff;
            border: 1px solid #E9ECEF;
            border-radius: 12px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, .14);
            z-index: 1000;
            display: none;
        }

            .adm-noti-dropdown.show {
                display: block;
                animation: searchFadeIn .2s ease;
            }

        .noti-header {
            padding: 14px 18px;
            border-bottom: 1px solid #E9ECEF;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .noti-header-title {
            font-weight: 600;
            font-size: 14px;
            color: #212529;
        }

        .noti-header-count {
            font-size: 11px;
            background: #EFF6FF;
            color: #1D4ED8;
            padding: 2px 8px;
            border-radius: 10px;
            font-weight: 600;
        }

        .noti-list {
            max-height: 340px;
            overflow-y: auto;
        }

        .noti-item {
            display: flex;
            gap: 12px;
            padding: 12px 18px;
            text-decoration: none;
            color: #374151;
            transition: background .1s;
            border-bottom: 1px solid #F3F4F6;
        }

            .noti-item:last-child {
                border-bottom: none;
            }

            .noti-item:hover {
                background: #F8FAFC;
            }

        .noti-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .noti-content {
            flex: 1;
            min-width: 0;
        }

        .noti-title {
            font-size: 13px;
            font-weight: 600;
            color: #212529;
            margin-bottom: 2px;
        }

        .noti-msg {
            font-size: 12px;
            color: #6B7280;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .noti-time {
            font-size: 11px;
            color: #9CA3AF;
            margin-top: 2px;
        }

        .noti-empty {
            padding: 30px 18px;
            text-align: center;
            color: #9CA3AF;
            font-size: 13px;
        }

        /* ── Topbar User ── */
        .adm-topbar-user {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .adm-topbar-name {
            font-size: 12px;
            font-weight: 500;
            color: #212529;
        }

        .adm-badge {
            font-size: 10px;
            font-weight: 500;
            padding: 2px 8px;
            border-radius: 4px;
        }

        .adm-badge-admin {
            background: #EFF6FF;
            color: #1D4ED8;
        }

        .adm-badge-editor {
            background: #F0FDF4;
            color: #15803D;
        }

        .adm-badge-other {
            background: #F8F9FA;
            color: #6C757D;
        }

        /* ── Content ── */
        .adm-content {
            padding: 22px 24px;
            flex: 1;
        }

        .adm-page-card {
            background: #fff;
            border: 1px solid #E9ECEF;
            border-radius: 10px;
            padding: 24px;
            min-height: calc(100vh - 130px);
        }

        /* ── Scrollbar ── */
        .adm-sidebar::-webkit-scrollbar {
            width: 3px;
        }

        .adm-sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .adm-sidebar::-webkit-scrollbar-thumb {
            background: #DEE2E6;
            border-radius: 3px;
        }
    </style>
</head>

<body>
    <div class="adm-wrapper">

        <!-- SIDEBAR -->
        <nav class="adm-sidebar">

            <a class="adm-logo" asp-controller="Home" asp-action="Index">
                <div class="adm-logo-icon">
                    <i class="bi bi-shop"></i>
                </div>
                <div>
                    <div class="adm-logo-name">BakeryHouse</div>
                    <div class="adm-logo-sub">Quản trị</div>
                </div>
            </a>

            <div class="adm-nav">

                <span class="adm-nav-label">Tổng quan</span>
                <a class="adm-nav-item" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <span class="adm-nav-label">Nội dung</span>
                <a class="adm-nav-item" asp-controller="Category" asp-action="Index">
                    <i class="bi bi-grid"></i> Danh mục
                </a>
                <a class="adm-nav-item" asp-controller="Post" asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i> Bài viết
                </a>
                <a class="adm-nav-item" asp-controller="Banners" asp-action="Index">
                    <i class="bi bi-images"></i> Banner
                </a>
                <a class="adm-nav-item" asp-controller="User" asp-action="Index">
                    <i class="bi bi-people"></i> Thành viên
                </a>

                <span class="adm-nav-label">Cửa hàng</span>
                <a class="adm-nav-item" asp-controller="CategoriesProducts" asp-action="Index">
                    <i class="bi bi-tags"></i> Danh mục sản phẩm
                </a>
                <a class="adm-nav-item" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Sản phẩm
                </a>
                <a class="adm-nav-item" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-person-vcard"></i> Khách hàng
                </a>
                <a class="adm-nav-item" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-cart-check"></i> Đơn hàng
                </a>
                <a class="adm-nav-item" asp-controller="OrderDetails" asp-action="Index">
                    <i class="bi bi-receipt"></i> Chi tiết đơn hàng
                </a>

            </div>

            @if (User.Identity.IsAuthenticated)
            {
                var fullName = User.FindFirst("FullName")?.Value ?? "Admin";
                var initials = fullName.Length > 0 ? fullName.Substring(0, 1).ToUpper() : "A";
                var roleVal = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                <div class="adm-sidebar-footer">
                    <div class="adm-user-row">
                        <div class="adm-avatar">@initials</div>
                        <div>
                            <div class="adm-user-name">@fullName</div>
                            <div class="adm-user-role">@roleVal</div>
                        </div>
                        <a class="adm-logout"
                           asp-controller="Account"
                           asp-action="Logout"
                           title="Đăng xuất">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }

        </nav>

        <!-- MAIN -->
        <div class="adm-main">

            <!-- Topbar -->
            <div class="adm-topbar">
                <div>
                    <h1 class="adm-page-title">@ViewData["Title"]</h1>
                    <div class="adm-breadcrumb">Admin / @ViewData["Title"]</div>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    var topName = User.FindFirst("FullName")?.Value ?? "Admin";
                    var topRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                    <div class="adm-topbar-right">

                        <!-- Tìm kiếm toàn cục -->
                        <div class="adm-search-wrap">
                            <div class="adm-search-box">
                                <i class="bi bi-search"></i>
                                <input type="text" class="adm-search-input" id="globalSearchInput"
                                       placeholder="Tìm đơn hàng, sản phẩm, bài viết..." autocomplete="off" />
                                <span class="adm-search-kbd">Ctrl+K</span>
                            </div>
                            <div class="adm-search-dropdown" id="searchDropdown"></div>
                        </div>

                        <!-- Thông báo -->
                        <div class="adm-noti-wrap">
                            <div class="adm-topbar-icon" id="notiToggle" title="Thông báo">
                                <i class="bi bi-bell"></i>
                                <span class="noti-badge" id="notiBadge">0</span>
                            </div>
                            <div class="adm-noti-dropdown" id="notiDropdown">
                                <div class="noti-header">
                                    <span class="noti-header-title">Thông báo</span>
                                    <span class="noti-header-count" id="notiCount">0</span>
                                </div>
                                <div class="noti-list" id="notiList">
                                    <div class="noti-empty">
                                        <i class="bi bi-bell-slash" style="font-size:24px;display:block;margin-bottom:6px;"></i>
                                        Chưa có thông báo nào
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="adm-topbar-user">
                            <span class="adm-topbar-name">@topName</span>
                            @if (topRole == "Admin")
                            {
                                <span class="adm-badge adm-badge-admin">
                                    <i class="bi bi-shield-lock-fill"></i> Admin
                                </span>
                            }
                            else if (topRole == "Editor")
                            {
                                <span class="adm-badge adm-badge-editor">
                                    <i class="bi bi-pencil-square"></i> Editor
                                </span>
                            }
                            else
                            {
                                <span class="adm-badge adm-badge-other">@topRole</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Page Content -->
            <div class="adm-content">
                <div class="adm-page-card">
                    @RenderBody()
                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Auto-highlight active nav item theo URL
        (function () {
            var path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.adm-nav-item').forEach(function (el) {
                var href = (el.getAttribute('href') || '').toLowerCase();
                if (href && href !== '/' && path.startsWith(href)) {
                    el.classList.add('active');
                }
            });
        })();

        // ══════════════════════════════════════
        // TÌM KIẾM TOÀN CỤC
        // ══════════════════════════════════════
        (function () {
            var input = document.getElementById('globalSearchInput');
            var dropdown = document.getElementById('searchDropdown');
            if (!input || !dropdown) return;

            var debounceTimer = null;

            // Phím tắt Ctrl+K
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                    e.preventDefault();
                    input.focus();
                    input.select();
                }
                if (e.key === 'Escape') {
                    dropdown.classList.remove('show');
                    input.blur();
                }
            });

            input.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                var q = input.value.trim();
                if (q.length < 1) {
                    dropdown.classList.remove('show');
                    return;
                }
                debounceTimer = setTimeout(function () {
                    fetchSearch(q);
                }, 300);
            });

            input.addEventListener('focus', function () {
                if (input.value.trim().length >= 1 && dropdown.innerHTML.trim()) {
                    dropdown.classList.add('show');
                }
            });

            // Click outside -> close
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.adm-search-wrap')) {
                    dropdown.classList.remove('show');
                }
            });

            function fetchSearch(q) {
                fetch('/Search/Query?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        renderResults(data);
                    })
                    .catch(function () {
                        dropdown.innerHTML = '<div class="search-empty">Lỗi kết nối</div>';
                        dropdown.classList.add('show');
                    });
            }

            function renderResults(data) {
                var html = '';
                var hasResults = false;

                if (data.orders && data.orders.length > 0) {
                    hasResults = true;
                    html += '<div class="search-group-label">Đơn hàng</div>';
                    data.orders.forEach(function (o) {
                        var statusText = o.status === 0 ? 'Chờ duyệt' : (o.status === 1 ? 'Đang giao' : 'Hoàn thành');
                        html += '<a class="search-result-item" href="' + o.url + '">' +
                            '<div class="search-result-icon sri-order"><i class="bi bi-cart3"></i></div>' +
                            '<div class="search-result-text">' +
                            '<div class="search-result-title">#' + o.id + ' — ' + o.customerName + '</div>' +
                            '<div class="search-result-sub">' + o.orderDate + ' • ' + statusText + '</div>' +
                            '</div></a>';
                    });
                }

                if (data.products && data.products.length > 0) {
                    hasResults = true;
                    html += '<div class="search-group-label">Sản phẩm</div>';
                    data.products.forEach(function (p) {
                        html += '<a class="search-result-item" href="' + p.url + '">' +
                            '<div class="search-result-icon sri-product"><i class="bi bi-box-seam"></i></div>' +
                            '<div class="search-result-text">' +
                            '<div class="search-result-title">' + p.name + '</div>' +
                            '<div class="search-result-sub">' + p.price + ' • Tồn kho: ' + p.stockQuantity + '</div>' +
                            '</div></a>';
                    });
                }

                if (data.posts && data.posts.length > 0) {
                    hasResults = true;
                    html += '<div class="search-group-label">Bài viết</div>';
                    data.posts.forEach(function (p) {
                        html += '<a class="search-result-item" href="' + p.url + '">' +
                            '<div class="search-result-icon sri-post"><i class="bi bi-file-earmark-text"></i></div>' +
                            '<div class="search-result-text">' +
                            '<div class="search-result-title">' + p.title + '</div>' +
                            '<div class="search-result-sub">' + (p.category || '') + ' • ' + p.createdDate + '</div>' +
                            '</div></a>';
                    });
                }

                if (data.customers && data.customers.length > 0) {
                    hasResults = true;
                    html += '<div class="search-group-label">Khách hàng</div>';
                    data.customers.forEach(function (c) {
                        html += '<a class="search-result-item" href="' + c.url + '">' +
                            '<div class="search-result-icon sri-customer"><i class="bi bi-person"></i></div>' +
                            '<div class="search-result-text">' +
                            '<div class="search-result-title">' + c.fullName + '</div>' +
                            '<div class="search-result-sub">' + c.email + (c.phone ? ' • ' + c.phone : '') + '</div>' +
                            '</div></a>';
                    });
                }

                if (!hasResults) {
                    html = '<div class="search-empty"><i class="bi bi-search" style="font-size:20px;display:block;margin-bottom:6px;"></i>Không tìm thấy kết quả</div>';
                }

                dropdown.innerHTML = html;
                dropdown.classList.add('show');
            }
        })();

        // ══════════════════════════════════════
        // THÔNG BÁO
        // ══════════════════════════════════════
        (function () {
            var toggle = document.getElementById('notiToggle');
            var dropdown = document.getElementById('notiDropdown');
            var badge = document.getElementById('notiBadge');
            var countEl = document.getElementById('notiCount');
            var list = document.getElementById('notiList');
            if (!toggle || !dropdown) return;

            var isOpen = false;

            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                isOpen = !isOpen;
                if (isOpen) {
                    dropdown.classList.add('show');
                    loadNotifications();
                } else {
                    dropdown.classList.remove('show');
                }
            });

            // Click outside -> close
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.adm-noti-wrap')) {
                    dropdown.classList.remove('show');
                    isOpen = false;
                }
            });

            // Tải thông báo khi trang load
            loadNotifications();

            function loadNotifications() {
                fetch('/Notification/GetAll')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        renderNotifications(data);
                    })
                    .catch(function () {
                        list.innerHTML = '<div class="noti-empty">Lỗi tải thông báo</div>';
                    });
            }

            function renderNotifications(data) {
                var count = data.count || 0;

                // Cập nhật badge
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.classList.add('show');
                } else {
                    badge.classList.remove('show');
                }
                countEl.textContent = count + ' mới';

                // Render danh sách
                if (!data.items || data.items.length === 0) {
                    list.innerHTML = '<div class="noti-empty"><i class="bi bi-bell-slash" style="font-size:24px;display:block;margin-bottom:6px;"></i>Chưa có thông báo nào</div>';
                    return;
                }

                var html = '';
                data.items.forEach(function (item) {
                    var bgColor = item.color + '18';
                    html += '<a class="noti-item" href="' + item.url + '">' +
                        '<div class="noti-icon" style="background:' + bgColor + ';color:' + item.color + '">' +
                        '<i class="bi ' + item.icon + '"></i></div>' +
                        '<div class="noti-content">' +
                        '<div class="noti-title">' + item.title + '</div>' +
                        '<div class="noti-msg">' + item.message + '</div>' +
                        '<div class="noti-time"><i class="bi bi-clock"></i> ' + item.time + '</div>' +
                        '</div></a>';
                });

                list.innerHTML = html;
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
