<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', system-ui, sans-serif;
            font-size: 14px;
            background: #F8F9FA;
            color: #212529;
        }

        /* ── Layout ── */
        .adm-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ── */
        .adm-sidebar {
            width: 220px;
            min-width: 220px;
            background: #fff;
            border-right: 1px solid #E9ECEF;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            overflow-y: auto;
            z-index: 100;
        }

        .adm-logo {
            padding: 16px;
            border-bottom: 1px solid #E9ECEF;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .adm-logo-icon {
            width: 30px;
            height: 30px;
            background: #2563EB;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 15px;
            flex-shrink: 0;
        }

        .adm-logo-name {
            font-size: 14px;
            font-weight: 600;
            color: #212529;
        }

        .adm-logo-sub {
            font-size: 10px;
            color: #6C757D;
        }

        /* Nav */
        .adm-nav {
            padding: 10px 8px;
            flex: 1;
        }

        .adm-nav-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #ADB5BD;
            padding: 0 8px;
            margin: 10px 0 4px;
            display: block;
        }

            .adm-nav-label:first-child {
                margin-top: 0;
            }

        .adm-nav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 8px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 13px;
            color: #495057;
            transition: background 0.12s, color 0.12s;
            margin-bottom: 1px;
        }

            .adm-nav-item i {
                font-size: 16px;
                width: 18px;
                text-align: center;
                flex-shrink: 0;
            }

            .adm-nav-item:hover {
                background: #F1F3F5;
                color: #212529;
            }

            .adm-nav-item.active {
                background: #EFF6FF;
                color: #1D4ED8;
                font-weight: 500;
            }

        /* Sidebar footer */
        .adm-sidebar-footer {
            padding: 12px 16px;
            border-top: 1px solid #E9ECEF;
        }

        .adm-user-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .adm-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #EFF6FF;
            color: #1D4ED8;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .adm-user-name {
            font-size: 12px;
            font-weight: 500;
            color: #212529;
        }

        .adm-user-role {
            font-size: 10px;
            color: #6C757D;
        }

        .adm-logout {
            margin-left: auto;
            color: #ADB5BD;
            text-decoration: none;
            font-size: 16px;
            display: flex;
            align-items: center;
            transition: color 0.12s;
        }

            .adm-logout:hover {
                color: #DC3545;
            }

        /* ── Main ── */
        .adm-main {
            margin-left: 220px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── Topbar ── */
        .adm-topbar {
            background: #fff;
            border-bottom: 1px solid #E9ECEF;
            padding: 11px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .adm-page-title {
            font-size: 15px;
            font-weight: 600;
            color: #212529;
            margin: 0;
        }

        .adm-breadcrumb {
            font-size: 11px;
            color: #6C757D;
            margin-top: 1px;
        }

        .adm-topbar-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .adm-search-box {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #F8F9FA;
            border: 1px solid #E9ECEF;
            border-radius: 6px;
            padding: 5px 10px;
            font-size: 12px;
            color: #ADB5BD;
            cursor: text;
        }

            .adm-search-box i {
                font-size: 13px;
            }

        .adm-topbar-icon {
            width: 30px;
            height: 30px;
            border: 1px solid #E9ECEF;
            border-radius: 6px;
            background: #F8F9FA;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6C757D;
            cursor: pointer;
            transition: background 0.12s;
        }

            .adm-topbar-icon:hover {
                background: #E9ECEF;
            }

            .adm-topbar-icon i {
                font-size: 15px;
            }

        .adm-topbar-user {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .adm-topbar-name {
            font-size: 12px;
            font-weight: 500;
            color: #212529;
        }

        .adm-badge {
            font-size: 10px;
            font-weight: 500;
            padding: 2px 8px;
            border-radius: 4px;
        }

        .adm-badge-admin {
            background: #EFF6FF;
            color: #1D4ED8;
        }

        .adm-badge-editor {
            background: #F0FDF4;
            color: #15803D;
        }

        .adm-badge-other {
            background: #F8F9FA;
            color: #6C757D;
        }

        /* ── Content ── */
        .adm-content {
            padding: 22px 24px;
            flex: 1;
        }

        .adm-page-card {
            background: #fff;
            border: 1px solid #E9ECEF;
            border-radius: 10px;
            padding: 24px;
            min-height: calc(100vh - 130px);
        }

        /* ── Scrollbar ── */
        .adm-sidebar::-webkit-scrollbar {
            width: 3px;
        }

        .adm-sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .adm-sidebar::-webkit-scrollbar-thumb {
            background: #DEE2E6;
            border-radius: 3px;
        }
    </style>
</head>

<body>
    <div class="adm-wrapper">

        <!-- SIDEBAR -->
        <nav class="adm-sidebar">

            <a class="adm-logo" asp-controller="Home" asp-action="Index">
                <div class="adm-logo-icon">
                    <i class="bi bi-shop"></i>
                </div>
                <div>
                    <div class="adm-logo-name">BakeryHouse</div>
                    <div class="adm-logo-sub">Quản trị</div>
                </div>
            </a>

            <div class="adm-nav">

                <span class="adm-nav-label">Tổng quan</span>
                <a class="adm-nav-item" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <span class="adm-nav-label">Nội dung</span>
                <a class="adm-nav-item" asp-controller="Category" asp-action="Index">
                    <i class="bi bi-grid"></i> Danh mục
                </a>
                <a class="adm-nav-item" asp-controller="Post" asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i> Bài viết
                </a>
                <a class="adm-nav-item" asp-controller="User" asp-action="Index">
                    <i class="bi bi-people"></i> Thành viên
                </a>

                <span class="adm-nav-label">Cửa hàng</span>
                <a class="adm-nav-item" asp-controller="CategoriesProducts" asp-action="Index">
                    <i class="bi bi-tags"></i> Danh mục sản phẩm
                </a>
                <a class="adm-nav-item" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Sản phẩm
                </a>
                <a class="adm-nav-item" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-person-vcard"></i> Khách hàng
                </a>
                <a class="adm-nav-item" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-cart-check"></i> Đơn hàng
                </a>
                <a class="adm-nav-item" asp-controller="OrderDetails" asp-action="Index">
                    <i class="bi bi-receipt"></i> Chi tiết đơn hàng
                </a>

            </div>

            @if (User.Identity.IsAuthenticated)
            {
                var fullName = User.FindFirst("FullName")?.Value ?? "Admin";
                var initials = fullName.Length > 0 ? fullName.Substring(0, 1).ToUpper() : "A";
                var roleVal = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                <div class="adm-sidebar-footer">
                    <div class="adm-user-row">
                        <div class="adm-avatar">@initials</div>
                        <div>
                            <div class="adm-user-name">@fullName</div>
                            <div class="adm-user-role">@roleVal</div>
                        </div>
                        <a class="adm-logout"
                           asp-controller="Account"
                           asp-action="Logout"
                           title="Đăng xuất">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }

        </nav>

        <!-- MAIN -->
        <div class="adm-main">

            <!-- Topbar -->
            <div class="adm-topbar">
                <div>
                    <h1 class="adm-page-title">@ViewData["Title"]</h1>
                    <div class="adm-breadcrumb">Admin / @ViewData["Title"]</div>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    var topName = User.FindFirst("FullName")?.Value ?? "Admin";
                    var topRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                    <div class="adm-topbar-right">
                        <div class="adm-search-box">
                            <i class="bi bi-search"></i> Tìm kiếm...
                        </div>
                        <div class="adm-topbar-icon">
                            <i class="bi bi-bell"></i>
                        </div>
                        <div class="adm-topbar-user">
                            <span class="adm-topbar-name">@topName</span>
                            @if (topRole == "Admin")
                            {
                                <span class="adm-badge adm-badge-admin">
                                    <i class="bi bi-shield-lock-fill"></i> Admin
                                </span>
                            }
                            else if (topRole == "Editor")
                            {
                                <span class="adm-badge adm-badge-editor">
                                    <i class="bi bi-pencil-square"></i> Editor
                                </span>
                            }
                            else
                            {
                                <span class="adm-badge adm-badge-other">@topRole</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Page Content -->
            <div class="adm-content">
                <div class="adm-page-card">
                    @RenderBody()
                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Auto-highlight active nav item theo URL
        (function () {
            var path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.adm-nav-item').forEach(function (el) {
                var href = (el.getAttribute('href') || '').toLowerCase();
                if (href && href !== '/' && path.startsWith(href)) {
                    el.classList.add('active');
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
