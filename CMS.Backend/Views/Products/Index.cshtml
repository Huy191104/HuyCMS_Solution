@model IEnumerable<CMS.Data.Entities.Product>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sản phẩm";
}

<style>

    .pg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .pg-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
    }

    .pg-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

        .pg-subtitle strong {
            color: #212529;
        }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563EB;
        color: #fff !important;
        border: none;
        border-radius: 6px;
        padding: 7px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
    }

        .btn-add:hover {
            background: #1D4ED8;
            color: #fff !important;
        }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 6px 10px;
        max-width: 280px;
        flex: 1;
    }

        .search-box i {
            font-size: 13px;
            color: #ADB5BD;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            width: 100%;
            font-size: 13px;
        }

    .count-badge {
        font-size: 11px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
    }

    .tbl-wrap {
        border: 1px solid #E9ECEF;
        border-radius: 8px;
        overflow: hidden;
    }

    .tbl {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .tbl thead tr {
            background: #F8F9FA;
        }

        .tbl th {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: #6C757D;
            border-bottom: 1px solid #E9ECEF;
        }

        .tbl td {
            padding: 12px 14px;
            border-bottom: 1px solid #F1F3F5;
            vertical-align: middle;
        }

        .tbl tbody tr:hover {
            background: #F8F9FA;
        }

        .tbl tbody tr:last-child td {
            border-bottom: none;
        }

    .id-badge {
        display: inline-block;
        background: #F1F3F5;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 500;
    }

    .product-thumb {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #E9ECEF;
    }

    .product-name {
        font-weight: 600;
    }

    .product-desc {
        color: #6C757D;
        font-size: 12px;
    }

    .cat-badge {
        display: inline-block;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 500;
    }

    .stock-good,
    .stock-low,
    .stock-out {
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
    }

    .stock-good {
        background: #DCFCE7;
        color: #166534;
        border: 1px solid #BBF7D0;
    }

    .stock-low {
        background: #FEF3C7;
        color: #92400E;
        border: 1px solid #FDE68A;
    }

    .stock-out {
        background: #FEE2E2;
        color: #991B1B;
        border: 1px solid #FECACA;
    }

    .price-text {
        color: #16A34A;
        font-weight: 700;
        white-space: nowrap;
    }

    .actions {
        display: flex;
        gap: 5px;
        justify-content: center;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #EFF6FF;
        color: #1D4ED8 !important;
        border: 1px solid #BFDBFE;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #DBEAFE;
            color: #1D4ED8 !important;
        }

    .btn-del {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #FEF2F2;
        color: #991B1B !important;
        border: 1px solid #FECACA;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        text-decoration: none;
    }
    .btn-del:hover {
                background: #FEE2E2;
                color: #991B1B !important;
            }

    .empty-state {
        text-align: center;
        padding: 50px 0;
        color: #ADB5BD;
    }

        .empty-state i {
            font-size: 32px;
            display: block;
            margin-bottom: 8px;
        }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .pagination {
        display: flex;
        gap: 6px;
    }

    .page-btn {
        min-width: 38px;
        height: 38px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 500;
    }

        .page-btn:hover {
            background: #F3F4F6;
        }

        .page-btn.active {
            background: #2563EB;
            color: white;
            border-color: #2563EB;
        }


</style>

<div class="pg-header">
    <div>
        <h2 class="pg-title">Danh sách sản phẩm</h2>
        <div class="pg-subtitle">
            Tổng số:
            <strong>@ViewBag.TotalItems sản phẩm</strong>
        </div>
    </div>

    <a asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle"></i>
        Thêm sản phẩm
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="toolbar">

    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               id="searchInput"
               placeholder="Tìm theo tên sản phẩm..." />
    </div>

    <span class="count-badge" id="countBadge">
        @ViewBag.TotalItems kết quả
    </span>

</div>

<div class="tbl-wrap">

    <table class="tbl" id="productTable">

        <thead>
            <tr>
                <th style="width:80px">ID</th>
                <th style="width:120px">Ảnh</th>
                <th>Tên sản phẩm</th>
                <th style="width:160px">Danh mục</th>
                <th>Mô tả</th>
                <th style="width:100px">Tồn kho</th>
                <th style="width:120px">Giá bán</th>
                <th style="width:180px;text-align:center">Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8">
                        <div class="empty-state">
                            <i class="bi bi-box-seam"></i>
                            Chưa có sản phẩm nào.
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <span class="id-badge">
                                #@item.Id
                            </span>
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     class="product-thumb" />
                            }
                        </td>

                        <td>
                            <div class="product-name">
                                @item.Name
                            </div>
                        </td>

                        <td>
                            <span class="cat-badge">
                                @(item.CategoryProduct?.Name ?? "Chưa phân loại")
                            </span>
                        </td>

                        <td>
                            <span class="product-desc">
                                @item.Description
                            </span>
                        </td>

                        <td>

                            @if (item.StockQuantity > 10)
                            {
                                <span class="stock-good">
                                    @item.StockQuantity
                                </span>
                            }
                            else if (item.StockQuantity > 0)
                            {
                                <span class="stock-low">
                                    @item.StockQuantity
                                </span>
                            }
                            else
                            {
                                <span class="stock-out">
                                    Hết hàng
                                </span>
                            }

                        </td>

                        <td>
                            <span class="price-text">
                                @item.Price.ToString("N0") ₫
                            </span>
                        </td>

                        <td>
                            <div class="actions">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn-edit">
                                    <i class="bi bi-pencil-square"></i>
                                    Sửa
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn-del">
                                    <i class="bi bi-trash"></i>
                                    Xóa
                                </a>

                            </div>
                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>
@if (ViewBag.TotalPages > 1)
{
    <div class="pagination-wrap">

        <div class="pagination">

            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   class="page-btn">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")">
                    @i
                </a>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   class="page-btn">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }

        </div>

    </div>
}

@section Scripts {

    <script>

        const searchInput = document.getElementById('searchInput');
        const countBadge = document.getElementById('countBadge');

        searchInput.addEventListener('input', function () {

            const keyword = this.value.toLowerCase();
            const rows = document.querySelectorAll('#productTable tbody tr');

            let visible = 0;

            rows.forEach(row => {

                const name = row.querySelector('.product-name');

                if (!name) return;

                const match = name.textContent.toLowerCase().includes(keyword);

                row.style.display = match ? '' : 'none';

                if (match) visible++;

            });

            countBadge.textContent = visible + ' kết quả';

        });

    </script>

}