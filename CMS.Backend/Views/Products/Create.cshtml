@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm sản phẩm";
}

<style>

    .cf-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .cf-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #2563EB;
        flex-shrink: 0;
    }

    .cf-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
    }

    .cf-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

    .cf-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 16px;
        align-items: start;
    }

    .cf-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 10px;
        padding: 20px;
    }

    .cf-card-title {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #6C757D;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #E9ECEF;
    }

    .cf-group {
        margin-bottom: 16px;
    }

    .cf-label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 6px;
        color: #212529;
    }

    .cf-input {
        width: 100%;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        outline: none;
        transition: .15s;
    }

        .cf-input:focus {
            border-color: #2563EB;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    textarea.cf-input {
        resize: vertical;
        min-height: 180px;
    }

    .cf-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        background: #2563EB;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 500;
    }

        .btn-save:hover {
            background: #1D4ED8;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        background: #F8F9FA;
        color: #495057;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 9px 16px;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #E9ECEF;
            color: #212529;
        }

    .img-preview-wrap {
        width: 100%;
        aspect-ratio: 1/1;
        border: 1px dashed #DEE2E6;
        border-radius: 8px;
        overflow: hidden;
        background: #F8F9FA;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
    }

        .img-preview-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .img-placeholder {
        text-align: center;
        color: #ADB5BD;
    }

        .img-placeholder i {
            font-size: 32px;
            display: block;
            margin-bottom: 6px;
        }

    .field-validation-error {
        color: #DC3545;
        font-size: 11px;
        margin-top: 4px;
        display: block;
    }

    /* CKEditor Custom height */
    .ck-editor__editable_inline {
        min-height: 250px;
    }

</style>

<div class="cf-header">

    <div class="cf-header-icon">
        <i class="bi bi-box-seam"></i>
    </div>

    <div>
        <h2 class="cf-title">Thêm sản phẩm mới</h2>
        <div class="cf-subtitle">
            Tạo sản phẩm mới trong hệ thống
        </div>
    </div>

</div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div class="cf-layout">

        <!-- LEFT -->

        <div>

            <div class="cf-card">

                <div class="cf-card-title">
                    Thông tin sản phẩm
                </div>

                <div class="cf-group">
                    <label class="cf-label">
                        <i class="bi bi-tag"></i>
                        Tên sản phẩm
                    </label>

                    <input asp-for="Name"
                           class="cf-input"
                           placeholder="Nhập tên sản phẩm..." />

                    <span asp-validation-for="Name"
                          class="field-validation-error"></span>
                </div>

                <div class="cf-group">
                    <label class="cf-label">
                        <i class="bi bi-card-text"></i>
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              class="cf-input"
                              placeholder="Nhập mô tả sản phẩm..."></textarea>
                </div>

            </div>

        </div>

        <!-- RIGHT -->

        <div>

            <div class="cf-card" style="margin-bottom:16px">

                <div class="cf-card-title">
                    Giá & Kho hàng
                </div>

                <div class="cf-group">
                    <label class="cf-label">
                        <i class="bi bi-currency-dollar"></i>
                        Giá bán
                    </label>

                    <input asp-for="Price"
                           class="cf-input" />
                </div>

                <div class="cf-group">
                    <label class="cf-label">
                        <i class="bi bi-box"></i>
                        Số lượng tồn kho
                    </label>

                    <input asp-for="StockQuantity"
                           class="cf-input" />
                </div>

                <div class="cf-group">

                    <label class="cf-label">
                        <i class="bi bi-grid"></i>
                        Danh mục
                    </label>

                    <select asp-for="CategoryProductId"
                            class="cf-input">

                        @foreach (var item in ViewBag.Categories)
                        {
                            <option value="@item.Id">
                                @item.Name
                            </option>
                        }

                    </select>

                </div>

            </div>

            <div class="cf-card" style="margin-bottom:16px">

                <div class="cf-card-title">
                    Hình ảnh sản phẩm
                </div>

                <div class="img-preview-wrap" id="previewWrap">

                    <div class="img-placeholder">
                        <i class="bi bi-image"></i>
                        <div>Chưa chọn ảnh</div>
                    </div>

                </div>

                <input type="file"
                       id="imageInput"
                       name="ImageFile"
                       accept="image/*"
                       class="cf-input" />

            </div>

            <div class="cf-card">

                <div class="cf-card-title">
                    Hành động
                </div>

                <div class="cf-actions">

                    <button type="submit"
                            class="btn-save">
                        <i class="bi bi-check-circle"></i>
                        Lưu sản phẩm
                    </button>

                    <a asp-action="Index"
                       class="btn-cancel">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại danh sách
                    </a>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {

    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#Description'), {
                ckfinder: {
                    uploadUrl: '/Post/UploadCkImage'
                }
            })
            .catch(error => {
                console.error(error);
            });

        document.getElementById('imageInput')
            .addEventListener('change', function () {

                const file = this.files[0];
                const wrap = document.getElementById('previewWrap');

                if (file) {

                    const url = URL.createObjectURL(file);

                    wrap.innerHTML =
                        `<img src="${url}" alt="Preview">`;

                }
            });

    </script>

}