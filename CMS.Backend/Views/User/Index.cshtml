@model IEnumerable<CMS.Data.Entities.User>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý thành viên";
}

<style>

    .pg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .pg-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
    }

    .pg-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

        .pg-subtitle strong {
            color: #212529;
        }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563EB;
        color: #fff !important;
        border: none;
        border-radius: 6px;
        padding: 7px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #1D4ED8;
            color: #fff !important;
        }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 6px 10px;
        max-width: 280px;
        flex: 1;
    }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            width: 100%;
            font-size: 13px;
        }

    .count-badge {
        font-size: 11px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
        white-space: nowrap;
    }

    .tbl-wrap {
        border: 1px solid #E9ECEF;
        border-radius: 8px;
        overflow: hidden;
    }

    .tbl {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .tbl thead tr {
            background: #F8F9FA;
        }

        .tbl th {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #6C757D;
            border-bottom: 1px solid #E9ECEF;
        }

        .tbl td {
            padding: 11px 14px;
            border-bottom: 1px solid #F1F3F5;
            vertical-align: middle;
        }

        .tbl tbody tr:hover {
            background: #F8F9FA;
        }

        .tbl tbody tr:last-child td {
            border-bottom: none;
        }

    .id-badge {
        display: inline-block;
        background: #F1F3F5;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 500;
    }

    .role-admin {
        display: inline-block;
        background: #FEF2F2;
        color: #991B1B;
        border: 1px solid #FECACA;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 500;
    }

    .role-editor {
        display: inline-block;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 500;
    }

    .role-default {
        display: inline-block;
        background: #F1F3F5;
        color: #6C757D;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 5px;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #EFF6FF;
        color: #1D4ED8 !important;
        border: 1px solid #BFDBFE;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #DBEAFE;
        }

    .btn-del {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #FEF2F2;
        color: #991B1B !important;
        border: 1px solid #FECACA;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
    }

        .btn-del:hover {
            background: #FEE2E2;
        }

</style>

<div class="pg-header">

    <div>
        <h2 class="pg-title">Danh sách thành viên</h2>
        <div class="pg-subtitle">
            Tổng số: <strong>@Model.Count() thành viên</strong>
        </div>
    </div>

    <a asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle"></i>
        Thêm thành viên
    </a>

</div>

<div class="toolbar">

    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               id="searchInput"
               placeholder="Tìm theo tài khoản hoặc họ tên..." />
    </div>

    <span class="count-badge" id="countBadge">
        @Model.Count() kết quả
    </span>

</div>

<div class="tbl-wrap">

    <table class="tbl" id="userTable">

        <thead>
            <tr>
                <th width="80">ID</th>
                <th>Tên đăng nhập</th>
                <th>Họ tên</th>
                <th width="150">Vai trò</th>
                <th width="220">Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        <span class="id-badge">
                            #@item.Id
                        </span>
                    </td>

                    <td class="user-name">
                        @item.Username
                    </td>

                    <td class="full-name">
                        @item.FullName
                    </td>

                    <td>

                        @if (item.Role == "Admin")
                        {
                            <span class="role-admin">
                                Admin
                            </span>
                        }
                        else if (item.Role == "Editor")
                        {
                            <span class="role-editor">
                                Editor
                            </span>
                        }
                        else
                        {
                            <span class="role-default">
                                @item.Role
                            </span>
                        }

                    </td>

                    <td>

                        <div class="actions">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-edit">
                                <i class="bi bi-pencil-square"></i>
                                Sửa
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn-del">
                                <i class="bi bi-trash"></i>
                                Xóa
                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        const searchInput = document.getElementById('searchInput');
        const countBadge = document.getElementById('countBadge');

        searchInput.addEventListener('input', function () {

            const keyword = this.value.toLowerCase().trim();

            const rows = document.querySelectorAll('#userTable tbody tr');

            let visible = 0;

            rows.forEach(function (row) {

                const username =
                    row.querySelector('.user-name').textContent.toLowerCase();

                const fullname =
                    row.querySelector('.full-name').textContent.toLowerCase();

                const match =
                    username.includes(keyword) ||
                    fullname.includes(keyword);

                row.style.display = match ? '' : 'none';

                if (match) visible++;

            });

            countBadge.textContent = visible + ' kết quả';

        });

    </script>

}
