@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Dashboard";
}

<style>
    .pg-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .pg-title {
        font-size: 26px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 4px;
    }

    .pg-subtitle {
        color: #6C757D;
        font-size: 14px;
    }

    .welcome-box {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 24px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 12px;
        padding: 20px;
        transition: .2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,.05);
        }

    .stat-title {
        font-size: 13px;
        color: #6C757D;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #212529;
    }

    .stat-icon {
        float: right;
        font-size: 28px;
        color: #2563EB;
    }

    .cf-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 12px;
        overflow: hidden;
    }

    .cf-card-header {
        padding: 14px 18px;
        border-bottom: 1px solid #E9ECEF;
        font-weight: 600;
        color: #212529;
        background: #F8F9FA;
    }

    .cf-card-body {
        padding: 18px;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-warning {
        background: #FFF3CD;
        color: #856404;
    }

    .status-primary {
        background: #D6E4FF;
        color: #1D4ED8;
    }

    .status-success {
        background: #DCFCE7;
        color: #15803D;
    }

    .status-danger {
        background: #FEE2E2;
        color: #B91C1C;
    }

    .tbl-wrap {
        overflow-x: auto;
    }

    .tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .tbl th {
            background: #F8F9FA;
            padding: 12px;
            border-bottom: 1px solid #E9ECEF;
            font-size: 13px;
        }

        .tbl td {
            padding: 12px;
            border-bottom: 1px solid #F1F3F5;
            font-size: 13px;
        }

    .dashboard-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 24px;
    }

    @@media(max-width:992px) {

        .stats-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .dashboard-row {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width:576px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="pg-header">

    <div>
        <div class="pg-title">
            Dashboard
        </div>

        <div class="pg-subtitle">
            Tổng quan hệ thống quản trị CMS
        </div>
    </div>

</div>

<div class="welcome-box">

    Xin chào

    <strong>
        @User.FindFirst("FullName")?.Value
    </strong>

    @if (User.IsInRole("Admin"))
    {
        <span class="status-badge status-danger ms-2">
            Admin
        </span>
    }
    else
    {
        <span class="status-badge status-primary ms-2">
            Editor
        </span>
    }

</div>

<!-- THỐNG KÊ CHÍNH -->

<div class="stats-grid">

    <div class="stat-card">
        <i class="bi bi-grid stat-icon"></i>
        <div class="stat-title">Danh mục</div>
        <div class="stat-value">@ViewBag.TotalCategories</div>
    </div>

    <div class="stat-card">
        <i class="bi bi-newspaper stat-icon"></i>
        <div class="stat-title">Bài viết</div>
        <div class="stat-value">@ViewBag.TotalPosts</div>
    </div>

    <div class="stat-card">
        <i class="bi bi-box-seam stat-icon"></i>
        <div class="stat-title">Sản phẩm</div>
        <div class="stat-value">@ViewBag.TotalProducts</div>
    </div>

    <div class="stat-card">
        <i class="bi bi-people stat-icon"></i>
        <div class="stat-title">Thành viên</div>
        <div class="stat-value">@ViewBag.TotalUsers</div>
    </div>

</div>

<!-- THỐNG KÊ PHỤ -->

<div class="stats-grid">

    <div class="stat-card">
        <div class="stat-title">Khách hàng</div>
        <div class="stat-value">@ViewBag.TotalCustomers</div>
    </div>

    <div class="stat-card">
        <div class="stat-title">Đơn hàng</div>
        <div class="stat-value">@ViewBag.TotalOrders</div>
    </div>

    <div class="stat-card">
        <div class="stat-title">Chờ duyệt</div>
        <div class="stat-value text-warning">
            @ViewBag.PendingOrders
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-title">Sắp hết hàng</div>
        <div class="stat-value text-danger">
            @ViewBag.LowStockProducts
        </div>
    </div>

</div>

<!-- TRẠNG THÁI ĐƠN HÀNG -->

<div class="cf-card mb-4">

    <div class="cf-card-header">
        Trạng thái đơn hàng
    </div>

    <div class="cf-card-body">

        <span class="status-badge status-warning">
            Chờ duyệt: @ViewBag.PendingOrders
        </span>

        <span class="status-badge status-primary ms-2">
            Đang giao: @ViewBag.ShippingOrders
        </span>

        <span class="status-badge status-success ms-2">
            Hoàn thành: @ViewBag.CompletedOrders
        </span>

    </div>

</div>

<div class="dashboard-row">

    <!-- ĐƠN HÀNG MỚI -->

    <div class="cf-card">

        <div class="cf-card-header">
            Đơn hàng mới nhất
        </div>

        <div class="tbl-wrap">

            <table class="tbl">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ngày đặt</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in ViewBag.LatestOrders)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>
                                @item.OrderDate.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- BÀI VIẾT MỚI -->

    <div class="cf-card">

        <div class="cf-card-header">
            Bài viết mới nhất
        </div>

        <div class="tbl-wrap">

            <table class="tbl">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tiêu đề</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in ViewBag.LatestPosts)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>@item.Title</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>