@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Dashboard";
}

<style>
    /* ── Animation ── */
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .anim-in {
        animation: fadeInUp .45s cubic-bezier(.23,1,.32,1) both;
    }

    .anim-d1 { animation-delay: .05s; }
    .anim-d2 { animation-delay: .10s; }
    .anim-d3 { animation-delay: .15s; }
    .anim-d4 { animation-delay: .20s; }
    .anim-d5 { animation-delay: .25s; }
    .anim-d6 { animation-delay: .30s; }
    .anim-d7 { animation-delay: .35s; }
    .anim-d8 { animation-delay: .40s; }

    /* ── Header ── */
    .pg-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .pg-title {
        font-size: 26px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 4px;
    }

    .pg-subtitle {
        color: #6C757D;
        font-size: 14px;
    }

    /* ── Welcome box ── */
    .welcome-box {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 24px;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 15px;
        box-shadow: 0 4px 20px rgba(102, 126, 234, .25);
    }

    .welcome-box strong {
        font-weight: 700;
    }

    /* ── Stats Grid ── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 14px;
        padding: 20px;
        transition: .25s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, .07);
    }

    .stat-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #fff;
        margin-bottom: 14px;
    }

    .icon-blue { background: linear-gradient(135deg, #3B82F6, #2563EB); }
    .icon-green { background: linear-gradient(135deg, #10B981, #059669); }
    .icon-purple { background: linear-gradient(135deg, #8B5CF6, #7C3AED); }
    .icon-orange { background: linear-gradient(135deg, #F59E0B, #D97706); }
    .icon-pink { background: linear-gradient(135deg, #EC4899, #DB2777); }
    .icon-cyan { background: linear-gradient(135deg, #06B6D4, #0891B2); }
    .icon-red { background: linear-gradient(135deg, #EF4444, #DC2626); }
    .icon-indigo { background: linear-gradient(135deg, #6366F1, #4F46E5); }

    .stat-title {
        font-size: 13px;
        color: #6C757D;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #212529;
        line-height: 1.1;
    }

    .stat-value.text-green { color: #059669; }
    .stat-value.text-orange { color: #D97706; }
    .stat-value.text-red { color: #DC2626; }

    /* ── Card ── */
    .cf-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .03);
    }

    .cf-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid #E9ECEF;
        font-weight: 600;
        font-size: 15px;
        color: #212529;
        background: #FAFBFC;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cf-card-header i {
        font-size: 16px;
        color: #6C757D;
    }

    .cf-card-body {
        padding: 20px;
    }

    /* ── Status badges ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-warning { background: #FEF3C7; color: #92400E; }
    .status-primary { background: #DBEAFE; color: #1E40AF; }
    .status-success { background: #D1FAE5; color: #065F46; }
    .status-danger { background: #FEE2E2; color: #991B1B; }

    /* ── Status section ── */
    .status-section {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .status-item {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 12px;
        padding: 14px 20px;
        flex: 1;
        min-width: 160px;
        transition: .2s;
    }

    .status-item:hover {
        box-shadow: 0 4px 12px rgba(0, 0, 0, .06);
    }

    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dot-warning { background: #F59E0B; }
    .dot-primary { background: #3B82F6; }
    .dot-success { background: #10B981; }

    .status-label {
        font-size: 12px;
        color: #6C757D;
    }

    .status-count {
        font-size: 20px;
        font-weight: 700;
        color: #212529;
    }

    /* ── Table ── */
    .tbl-wrap { overflow-x: auto; }

    .tbl {
        width: 100%;
        border-collapse: collapse;
    }

    .tbl th {
        background: #F8F9FA;
        padding: 12px 16px;
        border-bottom: 2px solid #E9ECEF;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #6C757D;
        font-weight: 600;
        text-align: left;
    }

    .tbl td {
        padding: 12px 16px;
        border-bottom: 1px solid #F1F3F5;
        font-size: 13px;
        color: #495057;
    }

    .tbl tbody tr {
        transition: background .15s;
    }

    .tbl tbody tr:hover {
        background: #F8F9FA;
    }

    /* ── Chart container ── */
    .chart-container {
        position: relative;
        height: 280px;
        width: 100%;
    }

    /* ── Dashboard grid ── */
    .dashboard-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 24px;
    }

    .dashboard-row-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px;
        margin-top: 24px;
    }

    /* ── Low stock progress bar ── */
    .stock-bar-wrap {
        width: 100%;
        height: 6px;
        background: #F1F3F5;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 4px;
    }

    .stock-bar {
        height: 100%;
        border-radius: 3px;
        transition: width .6s ease;
    }

    .stock-critical { background: linear-gradient(90deg, #EF4444, #F87171); }
    .stock-low { background: linear-gradient(90deg, #F59E0B, #FBBF24); }

    .product-stock-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
    }

    .product-stock-info .pname {
        font-weight: 500;
        color: #374151;
    }

    .product-stock-info .pcount {
        font-weight: 600;
        font-size: 13px;
    }

    .pcount-critical { color: #EF4444; }
    .pcount-low { color: #F59E0B; }

    /* ── Responsive ── */
    @@media(max-width:1200px) {
        .dashboard-row-3 {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media(max-width:992px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-row,
        .dashboard-row-3 {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width:576px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- HEADER -->
<div class="pg-header anim-in">
    <div>
        <div class="pg-title">Dashboard</div>
        <div class="pg-subtitle">Tổng quan hệ thống quản trị CMS</div>
    </div>
    <div style="font-size:13px;color:#6C757D;">
        <i class="bi bi-calendar3"></i>
        @DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
    </div>
</div>

<!-- WELCOME -->
<div class="welcome-box anim-in anim-d1">
    <i class="bi bi-emoji-smile" style="font-size:24px;"></i>
    <div>
        Xin chào <strong>@User.FindFirst("FullName")?.Value</strong>!
        @if (User.IsInRole("Admin"))
        {
            <span class="status-badge" style="background:rgba(255,255,255,.2);color:#fff;margin-left:8px;">
                <i class="bi bi-shield-lock-fill"></i> Admin
            </span>
        }
        else
        {
            <span class="status-badge" style="background:rgba(255,255,255,.2);color:#fff;margin-left:8px;">
                <i class="bi bi-pencil-square"></i> Editor
            </span>
        }
        <span style="margin-left:8px;opacity:.85;">— Chúc bạn một ngày làm việc hiệu quả!</span>
    </div>
</div>

<!-- THỐNG KÊ CHÍNH -->
<div class="stats-grid">

    <div class="stat-card anim-in anim-d1">
        <div class="stat-card-icon icon-blue">
            <i class="bi bi-grid"></i>
        </div>
        <div class="stat-title">Danh mục</div>
        <div class="stat-value">@ViewBag.TotalCategories</div>
    </div>

    <div class="stat-card anim-in anim-d2">
        <div class="stat-card-icon icon-purple">
            <i class="bi bi-newspaper"></i>
        </div>
        <div class="stat-title">Bài viết</div>
        <div class="stat-value">@ViewBag.TotalPosts</div>
    </div>

    <div class="stat-card anim-in anim-d3">
        <div class="stat-card-icon icon-orange">
            <i class="bi bi-box-seam"></i>
        </div>
        <div class="stat-title">Sản phẩm</div>
        <div class="stat-value">@ViewBag.TotalProducts</div>
    </div>

    <div class="stat-card anim-in anim-d4">
        <div class="stat-card-icon icon-green">
            <i class="bi bi-people"></i>
        </div>
        <div class="stat-title">Thành viên</div>
        <div class="stat-value">@ViewBag.TotalUsers</div>
    </div>

</div>

<!-- THỐNG KÊ PHỤ -->
<div class="stats-grid">

    <div class="stat-card anim-in anim-d5">
        <div class="stat-card-icon icon-cyan">
            <i class="bi bi-person-vcard"></i>
        </div>
        <div class="stat-title">Khách hàng</div>
        <div class="stat-value">@ViewBag.TotalCustomers</div>
    </div>

    <div class="stat-card anim-in anim-d6">
        <div class="stat-card-icon icon-indigo">
            <i class="bi bi-cart-check"></i>
        </div>
        <div class="stat-title">Đơn hàng</div>
        <div class="stat-value">@ViewBag.TotalOrders</div>
    </div>

    <div class="stat-card anim-in anim-d7">
        <div class="stat-card-icon icon-orange">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div class="stat-title">Chờ duyệt</div>
        <div class="stat-value text-orange">@ViewBag.PendingOrders</div>
    </div>

    <div class="stat-card anim-in anim-d8">
        <div class="stat-card-icon icon-red">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <div class="stat-title">Sắp hết hàng</div>
        <div class="stat-value text-red">@ViewBag.LowStockProducts</div>
    </div>

</div>

<!-- TRẠNG THÁI ĐƠN HÀNG + DOANH THU -->
<div class="dashboard-row anim-in anim-d5">

    <!-- Trạng thái đơn hàng -->
    <div class="cf-card">
        <div class="cf-card-header">
            <i class="bi bi-pie-chart"></i> Trạng thái đơn hàng
        </div>
        <div class="cf-card-body" style="display: flex; gap: 20px; align-items: center; min-height: 250px;">
            <div style="flex: 1.2; display: flex; flex-direction: column; gap: 10px;">
                <div class="status-item" style="padding: 10px 14px; margin-bottom: 0;">
                    <div class="status-dot dot-warning"></div>
                    <div>
                        <div class="status-label">Chờ duyệt</div>
                        <div class="status-count" style="font-size: 18px;">@ViewBag.PendingOrders</div>
                    </div>
                </div>
                <div class="status-item" style="padding: 10px 14px; margin-bottom: 0;">
                    <div class="status-dot dot-primary"></div>
                    <div>
                        <div class="status-label">Đang giao</div>
                        <div class="status-count" style="font-size: 18px;">@ViewBag.ShippingOrders</div>
                    </div>
                </div>
                <div class="status-item" style="padding: 10px 14px; margin-bottom: 0;">
                    <div class="status-dot dot-success"></div>
                    <div>
                        <div class="status-label">Hoàn thành</div>
                        <div class="status-count" style="font-size: 18px;">@ViewBag.CompletedOrders</div>
                    </div>
                </div>
                <div style="margin-top: 8px; padding-top: 12px; border-top: 1px solid #E9ECEF; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 11px; color: #6C757D; margin-bottom: 2px;">Doanh thu hoàn thành</div>
                        <div style="font-size: 20px; font-weight: 700; color: #059669;">
                            @(((decimal)ViewBag.TotalRevenue).ToString("N0"))₫
                        </div>
                    </div>
                    <div class="stat-card-icon icon-green" style="margin-bottom: 0; width: 36px; height: 36px; font-size: 16px;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
            <div style="flex: 0.8; height: 180px; position: relative;">
                <canvas id="orderStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ doanh thu 7 ngày -->
    <div class="cf-card">
        <div class="cf-card-header">
            <i class="bi bi-graph-up"></i> Doanh thu 7 ngày gần nhất
        </div>
        <div class="cf-card-body">
            <div class="chart-container" style="height: 250px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- TOP SẢN PHẨM BÁN CHẠY + SẢN PHẨM SẮP HẾT HÀNG -->
<div class="dashboard-row anim-in anim-d6">
    <!-- Top 5 sản phẩm bán chạy -->
    <div class="cf-card">
        <div class="cf-card-header">
            <i class="bi bi-bar-chart-line"></i> Top 5 sản phẩm bán chạy nhất
        </div>
        <div class="cf-card-body">
            <div class="chart-container" style="height: 250px;">
                <canvas id="topProductsChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Sản phẩm sắp hết hàng -->
    <div class="cf-card">
        <div class="cf-card-header">
            <i class="bi bi-exclamation-triangle"></i> Sản phẩm sắp hết hàng
        </div>
        <div class="cf-card-body" style="min-height: 250px;">
            @if (((IEnumerable<dynamic>)ViewBag.LowStockProductList).Any())
            {
                @foreach (var item in ViewBag.LowStockProductList)
                {
                    var pct = Math.Min((int)item.StockQuantity * 10, 100);
                    var barClass = item.StockQuantity < 5 ? "stock-critical" : "stock-low";
                    var countClass = item.StockQuantity < 5 ? "pcount-critical" : "pcount-low";

                    <div style="margin-bottom:14px;">
                        <div class="product-stock-info">
                            <span class="pname">@item.Name</span>
                            <span class="pcount @countClass">@item.StockQuantity</span>
                        </div>
                        <div class="stock-bar-wrap">
                            <div class="stock-bar @barClass" style="width:@(pct)%"></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align:center;padding:30px 0;color:#6C757D;">
                    <i class="bi bi-check-circle" style="font-size:28px;color:#10B981;"></i>
                    <div style="margin-top:8px;">Tất cả sản phẩm đều đủ hàng!</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ĐƠN HÀNG MỚI + BÀI VIẾT MỚI -->
<div class="dashboard-row anim-in anim-d7">

    <!-- ĐƠN HÀNG MỚI NHẤT -->
    <div class="cf-card">
        <div class="cf-card-header">
            <i class="bi bi-cart3"></i> Đơn hàng mới nhất
        </div>
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.LatestOrders)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td>@(item.Customer != null ? item.Customer.FullName : "N/A")</td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == 0)
                                {
                                    <span class="status-badge status-warning">
                                        <i class="bi bi-clock"></i> Chờ duyệt
                                    </span>
                                }
                                else if (item.Status == 1)
                                {
                                    <span class="status-badge status-primary">
                                        <i class="bi bi-truck"></i> Đang giao
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-success">
                                        <i class="bi bi-check-circle"></i> Hoàn thành
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- BÀI VIẾT MỚI NHẤT -->
    <div class="cf-card">
        <div class="cf-card-header">
            <i class="bi bi-file-earmark-text"></i> Bài viết mới nhất
        </div>
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tiêu đề</th>
                        <th>Danh mục</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.LatestPosts)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td>@(item.Title.Length > 35 ? item.Title.Substring(0, 35) + "..." : item.Title)</td>
                            <td>
                                <span class="status-badge status-primary">
                                    @(item.Category != null ? item.Category.Name : "—")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <script>
        // Biểu đồ doanh thu 7 ngày
        (function () {
            var ctx = document.getElementById('revenueChart').getContext('2d');

            var gradient = ctx.createLinearGradient(0, 0, 0, 250);
            gradient.addColorStop(0, 'rgba(59, 130, 246, 0.3)');
            gradient.addColorStop(1, 'rgba(59, 130, 246, 0.01)');

            var labels = @Html.Raw(ViewBag.RevenueChartLabels);
            var data = @Html.Raw(ViewBag.RevenueChartData);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (₫)',
                        data: data,
                        borderColor: '#3B82F6',
                        backgroundColor: gradient,
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#3B82F6',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointHoverBackgroundColor: '#3B82F6',
                        pointHoverBorderColor: '#fff',
                        pointHoverBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1E293B',
                            titleColor: '#F1F5F9',
                            bodyColor: '#F1F5F9',
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: function (ctx) {
                                    return new Intl.NumberFormat('vi-VN').format(ctx.raw) + '₫';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9CA3AF', font: { size: 12 } }
                        },
                        y: {
                            grid: {
                                color: '#F3F4F6',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#9CA3AF',
                                font: { size: 12 },
                                callback: function (value) {
                                    if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
                                    if (value >= 1000) return (value / 1000).toFixed(0) + 'K';
                                    return value;
                                }
                            }
                        }
                    }
                }
            });
        })();

        // Biểu đồ trạng thái đơn hàng (Doughnut Chart)
        (function () {
            var ctx = document.getElementById('orderStatusChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Chờ duyệt', 'Đang giao', 'Hoàn thành'],
                    datasets: [{
                        data: [@ViewBag.PendingOrders, @ViewBag.ShippingOrders, @ViewBag.CompletedOrders],
                        backgroundColor: ['#F59E0B', '#3B82F6', '#10B981'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1E293B',
                            titleColor: '#F1F5F9',
                            bodyColor: '#F1F5F9',
                            cornerRadius: 6
                        }
                    },
                    cutout: '70%'
                }
            });
        })();

        // Biểu đồ top sản phẩm bán chạy (Bar Chart)
        (function () {
            var ctx = document.getElementById('topProductsChart').getContext('2d');
            var labels = @Html.Raw(ViewBag.TopProductNames ?? "[]");
            var data = @Html.Raw(ViewBag.TopProductQuantities ?? "[]");

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Số lượng bán',
                        data: data,
                        backgroundColor: '#8B5CF6',
                        borderRadius: 6,
                        maxBarThickness: 35
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1E293B',
                            cornerRadius: 6
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                color: '#9CA3AF',
                                font: { size: 11 },
                                callback: function(val, index) {
                                    let label = labels[index] || '';
                                    return label.length > 12 ? label.substring(0, 12) + '...' : label;
                                }
                            }
                        },
                        y: {
                            grid: { color: '#F3F4F6', drawBorder: false },
                            ticks: {
                                color: '#9CA3AF',
                                font: { size: 11 },
                                stepSize: 1
                            }
                        }
                    }
                }
            });
        })();
    </script>
}