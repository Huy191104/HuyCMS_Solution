@model CMS.Data.Entities.Category
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<style>
    .cf-wrap {
        max-width: 600px;
    }

    .cf-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .cf-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #2563EB;
        flex-shrink: 0;
    }

    .cf-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cf-id-badge {
        display: inline-flex;
        align-items: center;
        background: #F1F3F5;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 1px 8px;
        font-size: 11px;
        font-weight: 500;
        color: #495057;
    }

    .cf-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

    .cf-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 10px;
        padding: 24px;
    }

    .cf-group {
        margin-bottom: 20px;
    }

        .cf-group:last-of-type {
            margin-bottom: 0;
        }

    .cf-label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        font-weight: 500;
        color: #212529;
        margin-bottom: 6px;
    }

        .cf-label i {
            font-size: 14px;
            color: #6C757D;
        }

    .cf-required {
        color: #DC3545;
        font-size: 13px;
    }

    .cf-input {
        width: 100%;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        color: #212529;
        font-family: 'Segoe UI', system-ui, sans-serif;
        outline: none;
        transition: border-color 0.12s, background 0.12s;
    }

        .cf-input:focus {
            border-color: #2563EB;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
        }

        .cf-input::placeholder {
            color: #ADB5BD;
        }

    textarea.cf-input {
        resize: vertical;
        min-height: 96px;
    }

    .cf-input.is-changed {
        border-color: #2563EB;
        background: #fff;
    }

    .cf-hint {
        font-size: 11px;
        color: #ADB5BD;
        margin-top: 4px;
    }

    .cf-divider {
        border: none;
        border-top: 1px solid #E9ECEF;
        margin: 20px 0;
    }

    .cf-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-update {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'Segoe UI', system-ui, sans-serif;
        transition: background 0.12s;
    }

        .btn-update:hover {
            background: #1D4ED8;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        color: #495057;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.12s;
    }

        .btn-cancel:hover {
            background: #E9ECEF;
            color: #212529;
        }

    .field-validation-error {
        display: block;
        font-size: 11px;
        color: #DC3545;
        margin-top: 4px;
    }

    .input-validation-error {
        border-color: #DC3545 !important;
        background: #FFF5F5 !important;
    }

        .input-validation-error:focus {
            box-shadow: 0 0 0 3px rgba(220,53,69,0.1) !important;
        }
</style>

<div class="cf-wrap">

    <div class="cf-header">
        <div class="cf-header-icon">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div>
            <h2 class="cf-title">
                Chỉnh sửa danh mục
                <span class="cf-id-badge">#@Model.Id</span>
            </h2>
            <div class="cf-subtitle">Cập nhật thông tin cho danh mục này</div>
        </div>
    </div>

    <div class="cf-card">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="cf-group">
                <label class="cf-label" asp-for="Name">
                    <i class="bi bi-tag"></i>
                    Tên danh mục
                    <span class="cf-required">*</span>
                </label>
                <input asp-for="Name"
                       class="cf-input"
                       placeholder="Tên danh mục..." />
                <span asp-validation-for="Name" class="field-validation-error"></span>
                <div class="cf-hint">Tên danh mục sẽ hiển thị trên menu và trang sản phẩm.</div>
            </div>

            <div class="cf-group">
                <label class="cf-label" asp-for="Description">
                    <i class="bi bi-card-text"></i>
                    Mô tả
                </label>
                <textarea asp-for="Description"
                          class="cf-input"
                          rows="4"
                          placeholder="Mô tả ngắn về danh mục này (không bắt buộc)..."></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
                <div class="cf-hint">Bỏ trống nếu không cần mô tả.</div>
            </div>

            <hr class="cf-divider" />

            <div class="cf-actions">
                <button type="submit" class="btn-update">
                    <i class="bi bi-check-circle"></i>
                    Cập nhật thay đổi
                </button>
                <a asp-action="Index" class="btn-cancel">
                    <i class="bi bi-x-circle"></i>
                    Hủy bỏ
                </a>
            </div>

        </form>
    </div>

</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.querySelectorAll('.cf-input').forEach(function (el) {
            var original = el.value;
            el.addEventListener('input', function () {
                this.classList.toggle('is-changed', this.value !== original);
            });
        });
    </script>
}
