@model IEnumerable<CMS.Data.Entities.Post>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Bài viết";
}

<style>
    .pg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    .pg-title { font-size: 15px; font-weight: 600; color: #212529; margin: 0 0 2px; }
    .pg-subtitle { font-size: 12px; color: #6C757D; }
    .pg-subtitle strong { color: #212529; }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563EB;
        color: #fff !important;
        border: none;
        border-radius: 6px;
        padding: 7px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.12s;
    }
    .btn-add:hover { background: #1D4ED8; color: #fff !important; }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }
    .search-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 6px 10px;
        max-width: 280px;
        flex: 1;
    }
    .search-box i { font-size: 13px; color: #ADB5BD; }
    .search-box input {
        border: none; background: transparent;
        font-size: 13px; color: #212529; outline: none; width: 100%;
    }
    .search-box input::placeholder { color: #ADB5BD; }

    .count-badge {
        font-size: 11px; font-weight: 500;
        padding: 3px 10px; border-radius: 20px;
        background: #EFF6FF; color: #1D4ED8;
        border: 1px solid #BFDBFE; white-space: nowrap;
    }

    .tbl-wrap { border: 1px solid #E9ECEF; border-radius: 8px; overflow: hidden; }
    .tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
    .tbl thead tr { background: #F8F9FA; }
    .tbl th {
        padding: 10px 14px;
        font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.5px;
        color: #6C757D; text-align: left;
        border-bottom: 1px solid #E9ECEF;
    }
    .tbl td {
        padding: 11px 14px; color: #212529;
        border-bottom: 1px solid #F1F3F5; vertical-align: middle;
    }
    .tbl tbody tr:last-child td { border-bottom: none; }
    .tbl tbody tr:hover { background: #F8F9FA; }

    .id-badge {
        display: inline-block;
        background: #F1F3F5; border: 1px solid #DEE2E6;
        border-radius: 4px; padding: 1px 7px;
        font-size: 11px; font-weight: 500; color: #495057;
    }

    .post-thumb {
        width: 100px; height: 70px;
        border-radius: 8px; object-fit: cover;
        border: 1px solid #E9ECEF;
    }
    .post-no-thumb {
        width: 100px; height: 70px;
        border-radius: 8px;
        background: #F1F3F5; border: 1px solid #E9ECEF;
        display: flex; align-items: center; justify-content: center;
        color: #ADB5BD; font-size: 24px;
    }

    .post-title { font-weight: 500; color: #212529; }
    .post-excerpt { font-size: 12px; color: #6C757D; margin-top: 2px; }

    .cat-badge {
        display: inline-block;
        background: #EFF6FF; color: #1D4ED8;
        border: 1px solid #BFDBFE;
        border-radius: 4px; padding: 2px 8px;
        font-size: 11px; font-weight: 500;
    }
    .cat-none {
        display: inline-block;
        background: #F1F3F5; color: #6C757D;
        border: 1px solid #DEE2E6;
        border-radius: 4px; padding: 2px 8px;
        font-size: 11px;
    }

    .date-text { font-size: 12px; color: #6C757D; white-space: nowrap; }

    .actions { display: flex; align-items: center; justify-content: center; gap: 5px; }

    .btn-detail {
        display: inline-flex; align-items: center; gap: 4px;
        background: #F0FDF4; color: #15803D !important;
        border: 1px solid #BBF7D0; border-radius: 5px;
        padding: 5px 10px; font-size: 12px; font-weight: 500;
        text-decoration: none; transition: background 0.12s;
    }
    .btn-detail:hover { background: #DCFCE7; color: #15803D !important; }

    .btn-edit {
        display: inline-flex; align-items: center; gap: 4px;
        background: #EFF6FF; color: #1D4ED8 !important;
        border: 1px solid #BFDBFE; border-radius: 5px;
        padding: 5px 10px; font-size: 12px; font-weight: 500;
        text-decoration: none; transition: background 0.12s;
    }
    .btn-edit:hover { background: #DBEAFE; color: #1D4ED8 !important; }

    .btn-del {
        display: inline-flex; align-items: center; gap: 4px;
        background: #FEF2F2; color: #991B1B !important;
        border: 1px solid #FECACA; border-radius: 5px;
        padding: 5px 10px; font-size: 12px; font-weight: 500;
        text-decoration: none; transition: background 0.12s;
    }
    .btn-del:hover { background: #FEE2E2; color: #991B1B !important; }

    .empty-state { text-align: center; padding: 48px 0; color: #ADB5BD; }
    .empty-state i { font-size: 32px; display: block; margin-bottom: 8px; color: #DEE2E6; }
    .empty-state p { margin: 0; font-size: 13px; }

    .tbl-footer {
        display: flex; align-items: center; justify-content: space-between;
        margin-top: 12px; flex-wrap: wrap; gap: 8px;
    }
    .footer-info { font-size: 12px; color: #6C757D; }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .pagination {
        display: flex;
        gap: 6px;
    }

    .page-btn {
        min-width: 38px;
        height: 38px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 500;
    }

        .page-btn:hover {
            background: #F3F4F6;
        }

        .page-btn.active {
            background: #2563EB;
            color: white;
            border-color: #2563EB;
        }
</style>

<div class="pg-header">
    <div>
        <h2 class="pg-title">Danh sách bài viết</h2>
        <div class="pg-subtitle">Tổng số: <strong>@ViewBag.TotalItems bài viết</strong> trong hệ thống</div>
    </div>
    <a asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle"></i> Thêm bài viết mới
    </a>
</div>

<form method="get" action="@Url.Action("Index")" class="toolbar" id="filterForm">
    @if (ViewBag.CategoryFilterId != null)
    {
        <input type="hidden" name="id" value="@ViewBag.CategoryFilterId" />
    }
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Tìm theo tiêu đề..." />
    </div>
    <span class="count-badge" id="countBadge">@ViewBag.TotalItems kết quả</span>
</form>

<div class="tbl-wrap">
    <table class="tbl" id="postTable">
        <thead>
            <tr>
                <th style="width:80px">ID</th>
                <th style="width:140px">Ảnh</th>
                <th>Tiêu đề</th>
                <th style="width:170px">Danh mục</th>
                <th style="width:100px">Ngày đăng</th>
                <th style="width:250px;text-align:center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <i class="bi bi-file-earmark-x"></i>
                            <p>Chưa có bài viết nào. Hãy thêm bài viết đầu tiên!</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                        string content = System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", "");

                        if (content.Length > 80) content = content.Substring(0, 80) + "...";
                    <tr>
                        <td><span class="id-badge">#@item.Id</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="post-thumb" alt="@item.Title" />
                            }
                            else
                            {
                                <div class="post-no-thumb">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="post-title">@item.Title</div>
                            <div class="post-excerpt">@content</div>
                        </td>
                        <td>
                            @if (item.Category != null)
                            {
                                <span class="cat-badge">@item.Category.Name</span>
                            }
                            else
                            {
                                <span class="cat-none">Chưa phân loại</span>
                            }
                        </td>
                        <td>
                            <span class="date-text">@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-detail">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-del">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="tbl-footer">
    <div class="footer-info" id="footerInfo">
        Hiển thị <strong>@Model.Count()</strong> trong tổng <strong>@ViewBag.TotalItems</strong> bài viết
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <div class="pagination-wrap">
        <div class="pagination">
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-id="@ViewBag.CategoryFilterId"
                   asp-route-search="@ViewBag.Search"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   class="page-btn">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-id="@ViewBag.CategoryFilterId"
                   asp-route-search="@ViewBag.Search"
                   asp-route-page="@i"
                   class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")">
                    @i
                </a>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-id="@ViewBag.CategoryFilterId"
                   asp-route-search="@ViewBag.Search"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   class="page-btn">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}

@section Scripts {
    <!-- Đã chuyển sang tìm kiếm và lọc Server-side -->
}
