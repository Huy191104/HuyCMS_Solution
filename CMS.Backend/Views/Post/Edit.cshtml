@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<style>
    .cf-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .cf-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #2563EB;
        flex-shrink: 0;
    }

    .cf-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
    }

    .cf-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

    .cf-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 16px;
        align-items: start;
    }

    .cf-card {
        background: #fff;
        border: 1px solid #E9ECEF;
        border-radius: 10px;
        padding: 20px;
    }

    .cf-card-title {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #6C757D;
        margin: 0 0 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #E9ECEF;
    }

    .cf-group {
        margin-bottom: 16px;
    }

    .cf-label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        font-weight: 500;
        color: #212529;
        margin-bottom: 6px;
    }

        .cf-label i {
            font-size: 14px;
            color: #6C757D;
        }

    .cf-required {
        color: #DC3545;
    }

    .cf-input {
        width: 100%;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        color: #212529;
        outline: none;
        transition: .15s;
    }

        .cf-input:focus {
            border-color: #2563EB;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    textarea.cf-input {
        resize: vertical;
        min-height: 300px;
    }

    .cf-hint {
        font-size: 11px;
        color: #ADB5BD;
        margin-top: 4px;
    }

    .cf-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        width: 100%;
    }

        .btn-save:hover {
            background: #1D4ED8;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #F8F9FA;
        color: #495057;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        width: 100%;
    }

        .btn-cancel:hover {
            background: #E9ECEF;
            color: #212529;
        }

    .img-preview-wrap {
        width: 100%;
        aspect-ratio: 16/9;
        border: 1px dashed #DEE2E6;
        border-radius: 6px;
        background: #F8F9FA;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 8px;
    }

        .img-preview-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .img-preview-placeholder {
        text-align: center;
        color: #ADB5BD;
    }

        .img-preview-placeholder i {
            font-size: 28px;
            display: block;
            margin-bottom: 4px;
        }

        .img-preview-placeholder span {
            font-size: 11px;
        }

    .field-validation-error {
        color: #DC3545;
        font-size: 11px;
        margin-top: 4px;
        display: block;
    }
</style>

<div class="cf-header">
    <div class="cf-header-icon">
        <i class="bi bi-pencil-square"></i>
    </div>

    <div>
        <h2 class="cf-title">Chỉnh sửa bài viết</h2>
        <div class="cf-subtitle">
            Cập nhật nội dung và thông tin bài viết
        </div>
    </div>

</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="cf-layout">

        <div>
            <div class="cf-card">

                <div class="cf-card-title">
                    Nội dung bài viết
                </div>

                <div class="cf-group">
                    <label asp-for="Title" class="cf-label">
                        <i class="bi bi-fonts"></i>
                        Tiêu đề
                        <span class="cf-required">*</span>
                    </label>

                    <input asp-for="Title"
                           class="cf-input"
                           placeholder="Nhập tiêu đề bài viết..." />

                    <span asp-validation-for="Title"></span>
                </div>

                <div class="cf-group">
                    <label asp-for="Content" class="cf-label">
                        <i class="bi bi-text-paragraph"></i>
                        Nội dung chi tiết
                        <span class="cf-required">*</span>
                    </label>

                    <textarea asp-for="Content"
                              class="cf-input"
                              rows="12"></textarea>

                    <span asp-validation-for="Content"></span>
                </div>

            </div>
        </div>

        <div>

            <div class="cf-card" style="margin-bottom:16px">

                <div class="cf-card-title">
                    Thông tin bài viết
                </div>

                <div class="cf-group">
                    <label asp-for="CategoryId" class="cf-label">
                        <i class="bi bi-grid"></i>
                        Danh mục
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryList"
                            class="cf-input">

                        <option value="">-- Chọn danh mục --</option>

                    </select>
                </div>

                <div class="cf-group">
                    <label asp-for="CreatedDate" class="cf-label">
                        <i class="bi bi-calendar3"></i>
                        Ngày đăng
                    </label>

                    <input asp-for="CreatedDate"
                           type="date"
                           class="cf-input" />
                </div>

            </div>

            <div class="cf-card" style="margin-bottom:16px">

                <div class="cf-card-title">
                    Hình ảnh
                </div>

                <div class="img-preview-wrap" id="previewWrap">

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" />
                    }
                    else
                    {
                        <div class="img-preview-placeholder">
                            <i class="bi bi-image"></i>
                            <span>Chưa có ảnh</span>
                        </div>
                    }

                </div>

                <div class="cf-group">
                    <input type="file"
                           name="uploadImage"
                           id="imageInput"
                           class="cf-input"
                           accept="image/*" />

                    <div class="cf-hint">
                        JPG, PNG, WEBP. Khuyến nghị tỉ lệ 16:9.
                    </div>
                </div>

            </div>

            <div class="cf-card">

                <div class="cf-card-title">
                    Hành động
                </div>

                <div class="cf-actions">

                    <button type="submit" class="btn-save">
                        <i class="bi bi-cloud-arrow-up"></i>
                        Cập nhật bài viết
                    </button>

                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại danh sách
                    </a>

                </div>

            </div>

        </div>

    </div>
    ```

</form>

@section Scripts {

    ```
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <script>

        ClassicEditor
            .create(document.querySelector('#Content'))
            .catch(error => {
                console.error(error);
            });

        document.getElementById('imageInput').addEventListener('change', function () {

            const file = this.files[0];
            const wrap = document.getElementById('previewWrap');

            if (file) {

                const url = URL.createObjectURL(file);

                wrap.innerHTML =
                    '<img src="' + url + '" alt="preview">';

            }
        });

    </script>
```

}
