@model IEnumerable<CMS.Data.Entities.Banner>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Banner";
}

<style>
    .pg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    .pg-title { font-size: 15px; font-weight: 600; color: #212529; margin: 0 0 2px; }
    .pg-subtitle { font-size: 12px; color: #6C757D; }
    .pg-subtitle strong { color: #212529; }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563EB;
        color: #fff !important;
        border: none;
        border-radius: 6px;
        padding: 7px 16px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.12s;
    }
    .btn-add:hover { background: #1D4ED8; color: #fff !important; }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }
    .search-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 6px 10px;
        max-width: 280px;
        flex: 1;
    }
    .search-box i { font-size: 13px; color: #ADB5BD; }
    .search-box input {
        border: none; background: transparent;
        font-size: 13px; color: #212529; outline: none; width: 100%;
    }
    .search-box input::placeholder { color: #ADB5BD; }

    .count-badge {
        font-size: 11px; font-weight: 500;
        padding: 3px 10px; border-radius: 20px;
        background: #EFF6FF; color: #1D4ED8;
        border: 1px solid #BFDBFE; white-space: nowrap;
    }

    .tbl-wrap { border: 1px solid #E9ECEF; border-radius: 8px; overflow: hidden; }
    .tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
    .tbl thead tr { background: #F8F9FA; }
    .tbl th {
        padding: 10px 14px;
        font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.5px;
        color: #6C757D; text-align: left;
        border-bottom: 1px solid #E9ECEF;
    }
    .tbl td {
        padding: 11px 14px; color: #212529;
        border-bottom: 1px solid #F1F3F5; vertical-align: middle;
    }
    .tbl tbody tr:last-child td { border-bottom: none; }
    .tbl tbody tr:hover { background: #F8F9FA; }

    .id-badge {
        display: inline-block;
        background: #F1F3F5; border: 1px solid #DEE2E6;
        border-radius: 4px; padding: 1px 7px;
        font-size: 11px; font-weight: 500; color: #495057;
    }

    .banner-thumb {
        width: 120px; height: 60px;
        border-radius: 6px; object-fit: cover;
        border: 1px solid #E9ECEF;
    }

    .badge-active {
        background: #D1FAE5;
        color: #065F46;
        font-size: 11px;
        padding: 3px 8px;
        border-radius: 12px;
        font-weight: 500;
        border: 1px solid #A7F3D0;
    }

    .badge-inactive {
        background: #F3F4F6;
        color: #4B5563;
        font-size: 11px;
        padding: 3px 8px;
        border-radius: 12px;
        font-weight: 500;
        border: 1px solid #E5E7EB;
    }

    .actions { display: flex; align-items: center; justify-content: center; gap: 5px; }

    .btn-edit {
        display: inline-flex; align-items: center; gap: 4px;
        background: #EFF6FF; color: #1D4ED8 !important;
        border: 1px solid #BFDBFE; border-radius: 5px;
        padding: 5px 10px; font-size: 12px; font-weight: 500;
        text-decoration: none; transition: background 0.12s;
    }
    .btn-edit:hover { background: #DBEAFE; color: #1D4ED8 !important; }

    .btn-del {
        display: inline-flex; align-items: center; gap: 4px;
        background: #FEF2F2; color: #991B1B !important;
        border: 1px solid #FECACA; border-radius: 5px;
        padding: 5px 10px; font-size: 12px; font-weight: 500;
        text-decoration: none; transition: background 0.12s;
    }
    .btn-del:hover { background: #FEE2E2; color: #991B1B !important; }

    .empty-state { text-align: center; padding: 48px 0; color: #ADB5BD; }
    .empty-state i { font-size: 32px; display: block; margin-bottom: 8px; color: #DEE2E6; }
    .empty-state p { margin: 0; font-size: 13px; }

    .tbl-footer {
        display: flex; align-items: center; justify-content: space-between;
        margin-top: 12px; flex-wrap: wrap; gap: 8px;
    }
    .footer-info { font-size: 12px; color: #6C757D; }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .pagination {
        display: flex;
        gap: 6px;
    }

    .page-btn {
        min-width: 38px;
        height: 38px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 500;
    }

    .page-btn:hover {
        background: #F3F4F6;
    }

    .page-btn.active {
        background: #2563EB;
        color: white;
        border-color: #2563EB;
    }
</style>

<div class="pg-header">
    <div>
        <h2 class="pg-title">Danh sách Banner Slider</h2>
        <div class="pg-subtitle">Tổng số: <strong>@ViewBag.TotalItems banner</strong> trong hệ thống</div>
    </div>
    <a asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle"></i> Thêm banner mới
    </a>
</div>

<form method="get" action="@Url.Action("Index")" class="toolbar" id="filterForm">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Tìm theo tiêu đề..." />
    </div>
    <span class="count-badge" id="countBadge">@ViewBag.TotalItems kết quả</span>
</form>

<div class="tbl-wrap">
    <table class="tbl" id="bannerTable">
        <thead>
            <tr>
                <th style="width: 80px;">ID</th>
                <th style="width: 140px;">Hình ảnh</th>
                <th>Tiêu đề Banner</th>
                <th style="width: 250px;">Đường dẫn liên kết</th>
                <th style="width: 90px; text-align: center;">Thứ tự</th>
                <th style="width: 120px; text-align: center;">Trạng thái</th>
                <th style="width: 250px; text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <i class="bi bi-image-alt"></i>
                            <p>Chưa có banner nào. Hãy nhấn "Thêm Banner Mới" để bắt đầu.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="id-badge">#@item.Id</span></td>
                        <td>
                            <img src="@item.ImageUrl" alt="@item.Title" class="banner-thumb" />
                        </td>
                        <td>
                            <strong style="color: #212529;">@item.Title</strong>
                        </td>
                        <td class="text-muted">
                            @(string.IsNullOrEmpty(item.LinkUrl) ? "Không có" : item.LinkUrl)
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@item.Order</span>
                        </td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge-active">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge-inactive">Tạm ẩn</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-del">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="tbl-footer">
    <div class="footer-info" id="footerInfo">
        Hiển thị <strong>@(Model?.Count() ?? 0)</strong> trong tổng <strong>@ViewBag.TotalItems</strong> banner
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <div class="pagination-wrap">
        <div class="pagination">
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-search="@ViewBag.Search"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   class="page-btn">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-search="@ViewBag.Search"
                   asp-route-page="@i"
                   class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")">
                    @i
                </a>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-search="@ViewBag.Search"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   class="page-btn">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}
