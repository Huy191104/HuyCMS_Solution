@model IEnumerable<CMS.Data.Entities.OrderDetail>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng";
}
<style>
    .pg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .pg-title {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        margin: 0 0 2px;
    }

    .pg-subtitle {
        font-size: 12px;
        color: #6C757D;
    }

        .pg-subtitle strong {
            color: #212529;
        }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #F8F9FA;
        border: 1px solid #E9ECEF;
        border-radius: 6px;
        padding: 6px 10px;
        max-width: 280px;
        flex: 1;
    }

        .search-box i {
            font-size: 13px;
            color: #ADB5BD;
        }

        .search-box input {
            border: none;
            background: transparent;
            font-size: 13px;
            color: #212529;
            outline: none;
            width: 100%;
        }

    .count-badge {
        font-size: 11px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
        white-space: nowrap;
    }

    .tbl-wrap {
        border: 1px solid #E9ECEF;
        border-radius: 8px;
        overflow: hidden;
    }

    .tbl {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .tbl thead tr {
            background: #F8F9FA;
        }

        .tbl th {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #6C757D;
            text-align: left;
            border-bottom: 1px solid #E9ECEF;
        }

        .tbl td {
            padding: 11px 14px;
            color: #212529;
            border-bottom: 1px solid #F1F3F5;
            vertical-align: middle;
        }

        .tbl tbody tr:last-child td {
            border-bottom: none;
        }

        .tbl tbody tr:hover {
            background: #F8F9FA;
        }

    .id-badge {
        display: inline-block;
        background: #F1F3F5;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 1px 7px;
        font-size: 11px;
        font-weight: 500;
        color: #495057;
    }

    .cat-badge {
        display: inline-block;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 500;
    }

    .cat-none {
        display: inline-block;
        background: #F1F3F5;
        color: #6C757D;
        border: 1px solid #DEE2E6;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 11px;
    }

    .date-text {
        font-size: 12px;
        color: #6C757D;
        white-space: nowrap;
    }

    .actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-detail {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #F0FDF4;
        color: #15803D !important;
        border: 1px solid #BBF7D0;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: .12s;
    }

        .btn-detail:hover {
            background: #DCFCE7;
            color: #15803D !important;
        }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #EFF6FF;
        color: #1D4ED8 !important;
        border: 1px solid #BFDBFE;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: .12s;
    }

        .btn-edit:hover {
            background: #DBEAFE;
            color: #1D4ED8 !important;
        }

    .btn-del {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #FEF2F2;
        color: #991B1B !important;
        border: 1px solid #FECACA;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: .12s;
    }

        .btn-del:hover {
            background: #FEE2E2;
            color: #991B1B !important;
        }

    .tbl-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 12px;
    }

    .footer-info {
        font-size: 12px;
        color: #6C757D;
    }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .pagination {
        display: flex;
        gap: 6px;
    }

    .page-btn {
        min-width: 38px;
        height: 38px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 500;
    }

        .page-btn:hover {
            background: #F3F4F6;
        }

        .page-btn.active {
            background: #2563EB;
            color: white;
            border-color: #2563EB;
        }
</style>

<div class="pg-header">
    <div>
        <h2 class="pg-title">Chi tiết đơn hàng</h2>
        <div class="pg-subtitle">
            Tổng số:
            <strong>@ViewBag.TotalItems sản phẩm</strong>
        </div>
    </div>
</div>

<form method="get" action="@Url.Action("Index")" class="toolbar" id="filterForm">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Tìm theo sản phẩm..." />
    </div>

    <div class="search-box" style="max-width: 140px;">
        <i class="bi bi-hash"></i>
        <input type="number"
               name="orderId"
               value="@ViewBag.OrderId"
               placeholder="Mã đơn..."
               style="width: 100%; border: none; background: transparent; font-size: 13px; outline: none;" />
    </div>

    <div style="display: flex; gap: 8px; align-items: center;">
        <select name="productId" class="form-select form-select-sm" style="font-size: 13px; border-radius: 6px; padding: 6px 12px; border: 1px solid #E9ECEF; min-width: 220px;" onchange="this.form.submit()">
            <option value="">Tất cả sản phẩm</option>
            @if (ViewBag.ProductsList != null)
            {
                foreach (var prod in ViewBag.ProductsList)
                {
                    if (ViewBag.ProductId == prod.Id)
                    {
                        <option value="@prod.Id" selected="selected">@prod.Name</option>
                    }
                    else
                    {
                        <option value="@prod.Id">@prod.Name</option>
                    }
                }
            }
        </select>
        <button type="submit" class="btn btn-primary btn-sm" style="background: #2563EB; color: #fff; border: none; border-radius: 6px; padding: 6px 14px; font-size: 13px; font-weight: 500; cursor: pointer;">Lọc</button>
    </div>

    <span class="count-badge" id="countBadge" style="margin-left: auto;">
        @ViewBag.TotalItems kết quả
    </span>
</form>

<div class="tbl-wrap">

    <table class="tbl" id="detailTable">

        <thead>
            <tr>
                <th style="width:80px">ID</th>
                <th style="width:120px">Mã đơn</th>
                <th>Sản phẩm</th>
                <th style="width:120px">Số lượng</th>
                <th style="width:150px">Đơn giá</th>
                <th style="width:180px">Thành tiền</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        <span class="id-badge">
                            #@item.Id
                        </span>
                    </td>

                    <td>
                        <span class="cat-badge">
                            #@item.OrderId
                        </span>
                    </td>

                    <td class="product-name">
                        @(item.Product?.Name ?? "Không xác định")
                    </td>

                    <td>
                        <span class="count-badge">
                            @item.Quantity
                        </span>
                    </td>

                    <td class="text-success fw-semibold">
                        @item.UnitPrice.ToString("N0") VNĐ
                    </td>

                    <td class="text-success fw-bold">
                        @((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<div class="tbl-footer">
    <div class="footer-info" id="footerInfo">
        Hiển thị
        <strong>@Model.Count()</strong>
        trong tổng
        <strong>@ViewBag.TotalItems</strong>
        chi tiết đơn hàng
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <div class="pagination-wrap">
        <div class="pagination">
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-productId="@ViewBag.ProductId"
                   asp-route-orderId="@ViewBag.OrderId"
                   class="page-btn">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-search="@ViewBag.Search"
                   asp-route-productId="@ViewBag.ProductId"
                   asp-route-orderId="@ViewBag.OrderId"
                   class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")">
                    @i
                </a>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-productId="@ViewBag.ProductId"
                   asp-route-orderId="@ViewBag.OrderId"
                   class="page-btn">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}

@section Scripts {
    <!-- Đã chuyển sang tìm kiếm và lọc Server-side -->
}