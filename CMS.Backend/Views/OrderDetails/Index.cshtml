@model IEnumerable<CMS.Data.Entities.OrderDetail>

<div class="container mt-4">

    <h2 class="mb-4 text-success">
        CHI TIẾT ĐƠN HÀNG
    </h2>

    <table class="table table-bordered">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>OrderId</th>
                <th>ProductId</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.OrderId</td>
                    <td>@item.ProductId</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                </tr>
            }

        </tbody>

    </table>

</div>